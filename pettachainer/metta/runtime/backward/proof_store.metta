;; Durable backward proof-store contract.
;; Owns append-only &proof history, shared goal/result indexes, fold
;; source rows, current-view private rows and derivation index, frontier paths, and
;; materialized-fact marks. Shared row shapes remain canonical.
;; Current candidate/result rows keep goal and output indexes; stable result-key
;; rows preserve ordering while dirty groups rebuild once. Fold snapshots use
;; the replace policy (docs/metta/fold_node_contract.md). Supersession removes
;; current candidates without deleting their durable proof rows.
;; Merged and conjunction proofs retain raw children.
(: next-gid (-[det]-> Number))
(= (next-gid) (next-search-id bwd_gid))
(: next-pid (-[det]-> Number))
(= (next-pid) (next-search-id bwd_pid))
(: goal-by-id (-[semidet]-> Number StoredGoalRow))
(= (goal-by-id $gid) (once (match &goal (stored-goal-row $gid $depth $goal $expanded $pending) (stored-goal-row $gid $depth $goal $expanded $pending))))
(: proof-goal-key-by-goal-id (-[semidet]-> Number ProofGoalKey))
(= (proof-goal-key-by-goal-id $gid) (let (stored-goal-row $_gid $_depth $goal $_expanded $_pending) (goal-by-id $gid) (brand ProofGoalKey (goal-key $goal))))
(: index-goal-proof! (-[det]-> $space ProofGoalKey Number Bool))
(= (index-goal-proof! $space $key $pid) (add-space-atom! $space (make-space-row3 (index-hash $key) $key $pid)))
(: GoalOutputKey Type)
(: goal-output-key (-[det]-> ProofGoalKey ProofOutputKey GoalOutputKey))
(: GoalCurrentConfidenceRow Type)
(: current-confidence-row (-[det]-> Number (| Number NoCurrentScore) GoalCurrentConfidenceRow))
(: clear-current-confidence! (-[det]-> Number (List $none)))
(= (clear-current-confidence! $gid) (let $_removed (collapse (match &goal_current_confidence (current-confidence-row $gid $value) (remove-atom &goal_current_confidence (current-confidence-row $gid $value)))) ()))
(: GoalDemandRevisionRow Type)
(: goal-demand-revision-row
   (-[det]-> Number Number GoalDemandRevisionRow))
(: goal-demand-revision (-[det]-> Number Number))
(= (goal-demand-revision $gid)
   (chainer-first-or 0
      (collapse
         (once
            (match &goal_demand_revision
               (goal-demand-revision-row $gid $revision)
               $revision)))))

(: bump-goal-demand-revision! (-[det]-> Number Number))
(= (bump-goal-demand-revision! $gid)
   (let* (($revision (goal-demand-revision $gid))
          ($next (+ $revision 1))
          ($_metric
             (increment-backward-query-metric! demand-revision-bumps))
          ($_old
             (collapse
                (match &goal_demand_revision
                   (goal-demand-revision-row $gid $_old-revision)
                   (remove-atom &goal_demand_revision
                      (goal-demand-revision-row
                         $gid $_old-revision)))))
          ($_new
             (once
                (add-atom &goal_demand_revision
                   (goal-demand-revision-row $gid $next)))))
      $next))
(: clear-key-confidence! (-[det]-> ProofGoalKey (List $none)))
(= (clear-key-confidence! $key) (let $lkey (index-hash $key) (let $_cleared (collapse (match &goal_lookup ($lkey $saved-key $gid) (if (=alpha $saved-key $key) (clear-current-confidence! (stored-number $gid)) (empty)))) ())))
(: index-current! (-[det]-> ProofGoalKey ProofOutputKey Number Bool))
(= (index-current! $key $okey $pid) (let* (($khash (index-hash $key)) ($ohash (index-hash $okey)) ($ghash (index-hash (goal-output-key $key $okey))) ($_goal (once (add-atom &proof_current (current-row $khash $ohash $key $okey $pid))))) (once (add-atom &proof_current (current-out-row $ghash $key $okey $pid)))))
(: remove-current! (-[semidet]-> ProofGoalKey Number Bool))
(= (remove-current! $key $pid) (let* (($okey (output-key $pid)) ($khash (index-hash $key)) ($ohash (index-hash $okey)) ($ghash (index-hash (goal-output-key $key $okey))) ($_output (collapse (once (remove-atom &proof_current (current-out-row $ghash $key $okey $pid))))) ($removed (collapse (once (remove-atom &proof_current (current-row $khash $ohash $key $okey $pid)))))) (not (== $removed ()))))
(: current-proof-ids-for-goal-key (-[semidet]-> ProofGoalKey (List Number)))
(= (current-proof-ids-for-goal-key $key) (let* (($_metric (increment-backward-query-metric! current-proof-goal-lookups)) ($khash (index-hash $key))) (collapse (match &proof_current (current-row $khash $_ohash $saved-key $_output-key $pid) (if (=alpha $saved-key $key) (stored-number $pid) (empty))))))
(: current-output-pids (-[semidet]-> ProofGoalKey ProofOutputKey (List Number)))
(= (current-output-pids $key $okey) (let $ghash (index-hash (goal-output-key $key $okey)) (collapse (match &proof_current (current-out-row $ghash $saved-key $saved-okey $pid) (if (and (=alpha $saved-key $key) (=alpha $saved-okey $okey)) (stored-number $pid) (empty))))))
(: current-proof-result-id-for-output-key (-[semidet]-> ProofGoalKey ProofOutputKey Number))
(= (current-proof-result-id-for-output-key $key $okey) (let $ghash (index-hash (goal-output-key $key $okey)) (once (match &proof_current_result (current-out-row $ghash $saved-key $saved-okey $pid) (if (and (=alpha $saved-key $key) (=alpha $saved-okey $okey)) (stored-number $pid) (empty))))))
(: remove-result-output! (-[det]-> ProofGoalKey ProofOutputKey (List $none)))
(= (remove-result-output! $key $okey) (let $ghash (index-hash (goal-output-key $key $okey)) (let $_removed (collapse (match &proof_current_result (current-out-row $ghash $saved-key $saved-okey $pid) (if (and (=alpha $saved-key $key) (=alpha $saved-okey $okey)) (remove-atom &proof_current_result (current-out-row $ghash $saved-key $saved-okey $pid)) (empty)))) ())))
(: index-result! (-[semidet]-> ProofGoalKey ProofOutputKey Number Bool))
(= (index-result! $key $okey $pid) (let* (($khash (index-hash $key)) ($ghash (index-hash (goal-output-key $key $okey))) ($key-row-exists? (not (== (collapse (once (match &proof_current_result (result-key-row $khash $saved-key $saved-okey) (if (and (=alpha $saved-key $key) (=alpha $saved-okey $okey)) true (empty))))) ()))) ($_key (if $key-row-exists? () (once (add-atom &proof_current_result (result-key-row $khash $key $okey))))) ($_old (remove-result-output! $key $okey))) (once (add-atom &proof_current_result (current-out-row $ghash $key $okey $pid)))))
(: result-ids (-[semidet]-> ProofGoalKey (List Number)))
(= (result-ids $key) (let* (($_metric (increment-backward-query-metric! current-result-goal-lookups)) ($khash (index-hash $key))) (list_to_set (collapse (match &proof_current_result (result-key-row $khash $saved-key $okey) (if (=alpha $saved-key $key) (current-proof-result-id-for-output-key (brand ProofGoalKey $saved-key) (the ProofOutputKey $okey)) (empty)))))))
;; Key-only result/dirty rows have no ground PID. Erase their alpha-selected
;; clause: remove-atom would also unify with distinct variable-sharing patterns.
(: remove-result! (-[semidet]-> ProofGoalKey ProofOutputKey (List $none)))
(= (remove-result! $key $okey)
   (let*
      (($_output (remove-result-output! $key $okey))
       ($khash (index-hash $key))
       ($head
          (Predicate
             (cons &proof_current_result
                (result-key-row $khash $saved-key $saved-okey))))
       ($_key
          (collapse
             (let $_found (callPredicate (Predicate (clause $head true $ref)))
                (if (and (=alpha $saved-key $key) (=alpha $saved-okey $okey))
                   (callPredicate (Predicate (erase $ref)))
                   (empty))))))
      ()))
(: mark-dirty! (-[det]-> ProofGoalKey ProofOutputKey Bool))
(= (mark-dirty! $key $okey) (if (result-dirty? $key $okey) true (let $khash (index-hash $key) (once (add-atom &proof_current_result (dirty-key-row $khash $key $okey))))))
(: result-dirty? (-[det]-> ProofGoalKey ProofOutputKey Bool))
(= (result-dirty? $key $okey) (let $khash (index-hash $key) (not (== (collapse (once (match &proof_current_result (dirty-key-row $khash $saved-key $saved-okey) (if (and (=alpha $saved-key $key) (=alpha $saved-okey $okey)) true (empty))))) ()))))
(: dirty-keys (-[semidet]-> ProofGoalKey (List ProofOutputKey)))
(= (dirty-keys $key) (let $khash (index-hash $key) (collapse (match &proof_current_result (dirty-key-row $khash $saved-key $okey) (if (=alpha $saved-key $key) (the ProofOutputKey $okey) (empty))))))
(: clear-dirty! (-[det]-> ProofGoalKey ProofOutputKey (List $none)))
(= (clear-dirty! $key $okey)
   (let*
      (($khash (index-hash $key))
       ($head
          (Predicate
             (cons &proof_current_result
                (dirty-key-row $khash $saved-key $saved-okey))))
       ($_removed
          (collapse
             (let $_found (callPredicate (Predicate (clause $head true $ref)))
                (if (and (=alpha $saved-key $key) (=alpha $saved-okey $okey))
                   (callPredicate (Predicate (erase $ref)))
                   (empty))))))
      ()))
