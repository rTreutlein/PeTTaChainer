!(import! &self petta_chainer)

(= (TruthW2C $w) (/ $w (+ $w 1.0)))
(= (/safe $a $b) (if (> $b 0.0) (/ $a $b) 0.0))
(= (InductionFormula (STV $sA $_cA) (STV $sB $_cB) (STV $sC $_cC) (STV $sCA $cCA) (STV $sCB $cCB))
   (STV (+ (/safe (* (* $sCA $sCB) $sB) $sA) (* (- 1 (/safe (* $sCA $sB) $sA)) (/safe (- $sC (* $sB $sCB)) (- 1 $sB))))
      (TruthW2C (* (* $sCB $cCB) $cCA))))

!(set-base-rate ravenBigInheritanceKb (Inheritance raven) (STV 0.25 0.9))
!(set-base-rate ravenBigInheritanceKb (Inheritance (IntSet black)) (STV 0.25 0.9))
!(set-base-rate ravenBigInheritanceKb (Inheritance $x) (STV 0.25 0.9))

