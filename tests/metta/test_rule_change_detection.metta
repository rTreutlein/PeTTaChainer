!(import! &self ../../pettachainer/metta/petta_chainer)

;; A refined rule whose KB detects changes (set-rule-change-detection) keeps,
;; in each branch of its instance tally, the samples since the evidence last
;; favoured one rate; once the Bayes factor for their having a rate of their
;; own passes the setting, the tally keeps them alone
;; (docs/metta/hypothesis_rules.md, "Change detection").
!(set-evidence-confidence-k 5)

(: truth (-[semidet]-> KB Atom))
(= (truth $kb)
   (case (sk-key-value (sk-key (RuleTruth (Implication (A $x) (B $x))) ($kb MAIN Nil))) (
      ((sk-val ($_type $_kbctx $_proof $tv) $_ev $_deps) $tv)
      ($_none none))))

;; The rule held in 12 instances, then fails. Without detection each failure
;; moves the truth a twelfth; with it (Bayes factor 100) the third failure is
;; a change, and the truth is learned from the three failures alone.
!(set-rule-refinement offKb true)
!(set-positive-only-predicate offKb A)
!(compileadd offKb (: h (Implication (A $x) (B $x)) (STV 0.5 0.02)))
!(compileadd offKb (: a0 (A i0) (STV 1 1)))
!(compileadd offKb (: b0 (B i0) (STV 1 1)))
!(compileadd offKb (: a1 (A i1) (STV 1 1)))
!(compileadd offKb (: b1 (B i1) (STV 1 1)))
!(compileadd offKb (: a2 (A i2) (STV 1 1)))
!(compileadd offKb (: b2 (B i2) (STV 1 1)))
!(compileadd offKb (: a3 (A i3) (STV 1 1)))
!(compileadd offKb (: b3 (B i3) (STV 1 1)))
!(compileadd offKb (: a4 (A i4) (STV 1 1)))
!(compileadd offKb (: b4 (B i4) (STV 1 1)))
!(compileadd offKb (: a5 (A i5) (STV 1 1)))
!(compileadd offKb (: b5 (B i5) (STV 1 1)))
!(compileadd offKb (: a6 (A i6) (STV 1 1)))
!(compileadd offKb (: b6 (B i6) (STV 1 1)))
!(compileadd offKb (: a7 (A i7) (STV 1 1)))
!(compileadd offKb (: b7 (B i7) (STV 1 1)))
!(compileadd offKb (: a8 (A i8) (STV 1 1)))
!(compileadd offKb (: b8 (B i8) (STV 1 1)))
!(compileadd offKb (: a9 (A i9) (STV 1 1)))
!(compileadd offKb (: b9 (B i9) (STV 1 1)))
!(compileadd offKb (: a10 (A i10) (STV 1 1)))
!(compileadd offKb (: b10 (B i10) (STV 1 1)))
!(compileadd offKb (: a11 (A i11) (STV 1 1)))
!(compileadd offKb (: b11 (B i11) (STV 1 1)))
!(test (let (: $p $t $tv) (query 50 offKb (: $p (RuleTruth (Implication (A $x) (B $x))) $tv)) $tv) (STV 0.9957841483979765 0.7076372315035799))
!(set-rule-refinement onKb true)
!(set-rule-change-detection onKb 100)
!(set-positive-only-predicate onKb A)
!(compileadd onKb (: h (Implication (A $x) (B $x)) (STV 0.5 0.02)))
!(compileadd onKb (: a0 (A i0) (STV 1 1)))
!(compileadd onKb (: b0 (B i0) (STV 1 1)))
!(compileadd onKb (: a1 (A i1) (STV 1 1)))
!(compileadd onKb (: b1 (B i1) (STV 1 1)))
!(compileadd onKb (: a2 (A i2) (STV 1 1)))
!(compileadd onKb (: b2 (B i2) (STV 1 1)))
!(compileadd onKb (: a3 (A i3) (STV 1 1)))
!(compileadd onKb (: b3 (B i3) (STV 1 1)))
!(compileadd onKb (: a4 (A i4) (STV 1 1)))
!(compileadd onKb (: b4 (B i4) (STV 1 1)))
!(compileadd onKb (: a5 (A i5) (STV 1 1)))
!(compileadd onKb (: b5 (B i5) (STV 1 1)))
!(compileadd onKb (: a6 (A i6) (STV 1 1)))
!(compileadd onKb (: b6 (B i6) (STV 1 1)))
!(compileadd onKb (: a7 (A i7) (STV 1 1)))
!(compileadd onKb (: b7 (B i7) (STV 1 1)))
!(compileadd onKb (: a8 (A i8) (STV 1 1)))
!(compileadd onKb (: b8 (B i8) (STV 1 1)))
!(compileadd onKb (: a9 (A i9) (STV 1 1)))
!(compileadd onKb (: b9 (B i9) (STV 1 1)))
!(compileadd onKb (: a10 (A i10) (STV 1 1)))
!(compileadd onKb (: b10 (B i10) (STV 1 1)))
!(compileadd onKb (: a11 (A i11) (STV 1 1)))
!(compileadd onKb (: b11 (B i11) (STV 1 1)))
!(test (let (: $p $t $tv) (query 50 onKb (: $p (RuleTruth (Implication (A $x) (B $x))) $tv)) $tv) (STV 0.9957841483979765 0.7076372315035799))

!(compileadd offKb (: a12 (A i12) (STV 1 1)))
!(compileadd offKb (: b12 (B i12) (STV 0 1)))
!(test (query 0 offKb (: $p (A i0) $tv)) (: a0 (A i0) (STV 1 1)))
!(test (truth offKb) (STV 0.9197819314641745 0.7237880496054115))
!(compileadd onKb (: a12 (A i12) (STV 1 1)))
!(compileadd onKb (: b12 (B i12) (STV 0 1)))
!(test (query 0 onKb (: $p (A i0) $tv)) (: a0 (A i0) (STV 1 1)))
!(test (truth onKb) (STV 0.9197819314641745 0.7237880496054115))

!(compileadd offKb (: a13 (A i13) (STV 1 1)))
!(compileadd offKb (: b13 (B i13) (STV 0 1)))
!(test (query 0 offKb (: $p (A i0) $tv)) (: a0 (A i0) (STV 1 1)))
!(test (truth offKb) (STV 0.8545586107091173 0.7382478632478632))
!(compileadd onKb (: a13 (A i13) (STV 1 1)))
!(compileadd onKb (: b13 (B i13) (STV 0 1)))
!(test (query 0 onKb (: $p (A i0) $tv)) (: a0 (A i0) (STV 1 1)))
!(test (truth onKb) (STV 0.8545586107091173 0.7382478632478632))

!(compileadd offKb (: a14 (A i14) (STV 1 1)))
!(compileadd offKb (: b14 (B i14) (STV 0 1)))
!(test (query 0 offKb (: $p (A i0) $tv)) (: a0 (A i0) (STV 1 1)))
!(test (truth offKb) (STV 0.797972972972973 0.751269035532995))
!(compileadd onKb (: a14 (A i14) (STV 1 1)))
!(compileadd onKb (: b14 (B i14) (STV 0 1)))
!(test (query 0 onKb (: $p (A i0) $tv)) (: a0 (A i0) (STV 1 1)))
!(test (truth onKb) (STV 0.016447368421052634 0.38287153652392947))

;; Stationary samples, three of four positive, are no change: the truth is the
;; one without detection (test_instance_tally.metta).
!(set-rule-refinement steadyKb true)
!(set-rule-change-detection steadyKb 100)
!(set-positive-only-predicate steadyKb A)
!(compileadd steadyKb (: h (Implication (A $x) (B $x)) (STV 0.5 0.02)))
!(compileadd steadyKb (: a0 (A i0) (STV 1 1)))
!(compileadd steadyKb (: b0 (B i0) (STV 0 1)))
!(compileadd steadyKb (: a1 (A i1) (STV 1 1)))
!(compileadd steadyKb (: b1 (B i1) (STV 1 1)))
!(compileadd steadyKb (: a2 (A i2) (STV 1 1)))
!(compileadd steadyKb (: b2 (B i2) (STV 1 1)))
!(compileadd steadyKb (: a3 (A i3) (STV 1 1)))
!(compileadd steadyKb (: b3 (B i3) (STV 1 1)))
!(compileadd steadyKb (: a4 (A i4) (STV 1 1)))
!(compileadd steadyKb (: b4 (B i4) (STV 0 1)))
!(compileadd steadyKb (: a5 (A i5) (STV 1 1)))
!(compileadd steadyKb (: b5 (B i5) (STV 1 1)))
!(compileadd steadyKb (: a6 (A i6) (STV 1 1)))
!(compileadd steadyKb (: b6 (B i6) (STV 1 1)))
!(compileadd steadyKb (: a7 (A i7) (STV 1 1)))
!(compileadd steadyKb (: b7 (B i7) (STV 1 1)))
!(compileadd steadyKb (: a8 (A i8) (STV 1 1)))
!(compileadd steadyKb (: b8 (B i8) (STV 0 1)))
!(compileadd steadyKb (: a9 (A i9) (STV 1 1)))
!(compileadd steadyKb (: b9 (B i9) (STV 1 1)))
!(compileadd steadyKb (: a10 (A i10) (STV 1 1)))
!(compileadd steadyKb (: b10 (B i10) (STV 1 1)))
!(compileadd steadyKb (: a11 (A i11) (STV 1 1)))
!(compileadd steadyKb (: b11 (B i11) (STV 1 1)))
!(compileadd steadyKb (: a12 (A i12) (STV 1 1)))
!(compileadd steadyKb (: b12 (B i12) (STV 0 1)))
!(compileadd steadyKb (: a13 (A i13) (STV 1 1)))
!(compileadd steadyKb (: b13 (B i13) (STV 1 1)))
!(compileadd steadyKb (: a14 (A i14) (STV 1 1)))
!(compileadd steadyKb (: b14 (B i14) (STV 1 1)))
!(compileadd steadyKb (: a15 (A i15) (STV 1 1)))
!(compileadd steadyKb (: b15 (B i15) (STV 1 1)))
!(test (let (: $p $t $tv) (query 50 steadyKb (: $p (RuleTruth (Implication (A $x) (B $x))) $tv)) $tv)
   (STV 0.7484157160963244 0.7630560928433269))

;; Each branch detects on its own: in a CTV rule, P(B | A) flips after 8
;; instances while P(B | not A) stays at one half, and the negative branch
;; keeps all its samples.
!(set-rule-refinement ctvOffKb true)
!(compileadd ctvOffKb (: h (Implication (A $x) (B $x)) (CTV (STV 0.5 0.02) (STV 0.5 0.02))))
!(compileadd ctvOffKb (: a0 (A i0) (STV 1 1)))
!(compileadd ctvOffKb (: b0 (B i0) (STV 1 1)))
!(compileadd ctvOffKb (: a1 (A i1) (STV 0 1)))
!(compileadd ctvOffKb (: b1 (B i1) (STV 1 1)))
!(compileadd ctvOffKb (: a2 (A i2) (STV 1 1)))
!(compileadd ctvOffKb (: b2 (B i2) (STV 1 1)))
!(compileadd ctvOffKb (: a3 (A i3) (STV 0 1)))
!(compileadd ctvOffKb (: b3 (B i3) (STV 0 1)))
!(compileadd ctvOffKb (: a4 (A i4) (STV 1 1)))
!(compileadd ctvOffKb (: b4 (B i4) (STV 1 1)))
!(compileadd ctvOffKb (: a5 (A i5) (STV 0 1)))
!(compileadd ctvOffKb (: b5 (B i5) (STV 1 1)))
!(compileadd ctvOffKb (: a6 (A i6) (STV 1 1)))
!(compileadd ctvOffKb (: b6 (B i6) (STV 1 1)))
!(compileadd ctvOffKb (: a7 (A i7) (STV 0 1)))
!(compileadd ctvOffKb (: b7 (B i7) (STV 0 1)))
!(compileadd ctvOffKb (: a8 (A i8) (STV 1 1)))
!(compileadd ctvOffKb (: b8 (B i8) (STV 1 1)))
!(compileadd ctvOffKb (: a9 (A i9) (STV 0 1)))
!(compileadd ctvOffKb (: b9 (B i9) (STV 1 1)))
!(compileadd ctvOffKb (: a10 (A i10) (STV 1 1)))
!(compileadd ctvOffKb (: b10 (B i10) (STV 1 1)))
!(compileadd ctvOffKb (: a11 (A i11) (STV 0 1)))
!(compileadd ctvOffKb (: b11 (B i11) (STV 0 1)))
!(compileadd ctvOffKb (: a12 (A i12) (STV 1 1)))
!(compileadd ctvOffKb (: b12 (B i12) (STV 1 1)))
!(compileadd ctvOffKb (: a13 (A i13) (STV 0 1)))
!(compileadd ctvOffKb (: b13 (B i13) (STV 1 1)))
!(compileadd ctvOffKb (: a14 (A i14) (STV 1 1)))
!(compileadd ctvOffKb (: b14 (B i14) (STV 1 1)))
!(compileadd ctvOffKb (: a15 (A i15) (STV 0 1)))
!(compileadd ctvOffKb (: b15 (B i15) (STV 0 1)))
!(compileadd ctvOffKb (: a16 (A i16) (STV 1 1)))
!(compileadd ctvOffKb (: b16 (B i16) (STV 0 1)))
!(compileadd ctvOffKb (: a17 (A i17) (STV 0 1)))
!(compileadd ctvOffKb (: b17 (B i17) (STV 1 1)))
!(compileadd ctvOffKb (: a18 (A i18) (STV 1 1)))
!(compileadd ctvOffKb (: b18 (B i18) (STV 0 1)))
!(compileadd ctvOffKb (: a19 (A i19) (STV 0 1)))
!(compileadd ctvOffKb (: b19 (B i19) (STV 0 1)))
!(compileadd ctvOffKb (: a20 (A i20) (STV 1 1)))
!(compileadd ctvOffKb (: b20 (B i20) (STV 0 1)))
!(compileadd ctvOffKb (: a21 (A i21) (STV 0 1)))
!(compileadd ctvOffKb (: b21 (B i21) (STV 1 1)))
!(compileadd ctvOffKb (: a22 (A i22) (STV 1 1)))
!(compileadd ctvOffKb (: b22 (B i22) (STV 0 1)))
!(compileadd ctvOffKb (: a23 (A i23) (STV 0 1)))
!(compileadd ctvOffKb (: b23 (B i23) (STV 0 1)))
!(test (let (: $p $t $tv) (query 50 ctvOffKb (: $p (RuleTruth (Implication (A $x) (B $x))) $tv)) $tv) (CTV (STV 0.6652613827993255 0.7076372315035799) (STV 0.5 0.7076372315035799)))
!(set-rule-refinement ctvOnKb true)
!(set-rule-change-detection ctvOnKb 100)
!(compileadd ctvOnKb (: h (Implication (A $x) (B $x)) (CTV (STV 0.5 0.02) (STV 0.5 0.02))))
!(compileadd ctvOnKb (: a0 (A i0) (STV 1 1)))
!(compileadd ctvOnKb (: b0 (B i0) (STV 1 1)))
!(compileadd ctvOnKb (: a1 (A i1) (STV 0 1)))
!(compileadd ctvOnKb (: b1 (B i1) (STV 1 1)))
!(compileadd ctvOnKb (: a2 (A i2) (STV 1 1)))
!(compileadd ctvOnKb (: b2 (B i2) (STV 1 1)))
!(compileadd ctvOnKb (: a3 (A i3) (STV 0 1)))
!(compileadd ctvOnKb (: b3 (B i3) (STV 0 1)))
!(compileadd ctvOnKb (: a4 (A i4) (STV 1 1)))
!(compileadd ctvOnKb (: b4 (B i4) (STV 1 1)))
!(compileadd ctvOnKb (: a5 (A i5) (STV 0 1)))
!(compileadd ctvOnKb (: b5 (B i5) (STV 1 1)))
!(compileadd ctvOnKb (: a6 (A i6) (STV 1 1)))
!(compileadd ctvOnKb (: b6 (B i6) (STV 1 1)))
!(compileadd ctvOnKb (: a7 (A i7) (STV 0 1)))
!(compileadd ctvOnKb (: b7 (B i7) (STV 0 1)))
!(compileadd ctvOnKb (: a8 (A i8) (STV 1 1)))
!(compileadd ctvOnKb (: b8 (B i8) (STV 1 1)))
!(compileadd ctvOnKb (: a9 (A i9) (STV 0 1)))
!(compileadd ctvOnKb (: b9 (B i9) (STV 1 1)))
!(compileadd ctvOnKb (: a10 (A i10) (STV 1 1)))
!(compileadd ctvOnKb (: b10 (B i10) (STV 1 1)))
!(compileadd ctvOnKb (: a11 (A i11) (STV 0 1)))
!(compileadd ctvOnKb (: b11 (B i11) (STV 0 1)))
!(compileadd ctvOnKb (: a12 (A i12) (STV 1 1)))
!(compileadd ctvOnKb (: b12 (B i12) (STV 1 1)))
!(compileadd ctvOnKb (: a13 (A i13) (STV 0 1)))
!(compileadd ctvOnKb (: b13 (B i13) (STV 1 1)))
!(compileadd ctvOnKb (: a14 (A i14) (STV 1 1)))
!(compileadd ctvOnKb (: b14 (B i14) (STV 1 1)))
!(compileadd ctvOnKb (: a15 (A i15) (STV 0 1)))
!(compileadd ctvOnKb (: b15 (B i15) (STV 0 1)))
!(compileadd ctvOnKb (: a16 (A i16) (STV 1 1)))
!(compileadd ctvOnKb (: b16 (B i16) (STV 0 1)))
!(compileadd ctvOnKb (: a17 (A i17) (STV 0 1)))
!(compileadd ctvOnKb (: b17 (B i17) (STV 1 1)))
!(compileadd ctvOnKb (: a18 (A i18) (STV 1 1)))
!(compileadd ctvOnKb (: b18 (B i18) (STV 0 1)))
!(compileadd ctvOnKb (: a19 (A i19) (STV 0 1)))
!(compileadd ctvOnKb (: b19 (B i19) (STV 0 1)))
!(compileadd ctvOnKb (: a20 (A i20) (STV 1 1)))
!(compileadd ctvOnKb (: b20 (B i20) (STV 0 1)))
!(compileadd ctvOnKb (: a21 (A i21) (STV 0 1)))
!(compileadd ctvOnKb (: b21 (B i21) (STV 1 1)))
!(compileadd ctvOnKb (: a22 (A i22) (STV 1 1)))
!(compileadd ctvOnKb (: b22 (B i22) (STV 0 1)))
!(compileadd ctvOnKb (: a23 (A i23) (STV 0 1)))
!(compileadd ctvOnKb (: b23 (B i23) (STV 0 1)))
!(test (let (: $p $t $tv) (query 50 ctvOnKb (: $p (RuleTruth (Implication (A $x) (B $x))) $tv)) $tv) (CTV (STV 0.012437810945273632 0.4506726457399103) (STV 0.5 0.7076372315035799)))

;; A reader leaves its own sample out of the truth only while the tally holds
;; it: after the change an instance from before it leaves nothing out, one
;; from after it its own sample.
(: left-out (-[det]-> Statement Atom))
(= (left-out $statement)
   (case (collapse (match &sk_instance_change ($hash (sk-fold (onKb $_p $_e $_i $_f $_fin $_m)) $_s) $hash)) (
      ((cons $hash $_rest) (sk-left-out $hash (cons (index-hash (sk-key $statement (onKb MAIN Nil))) ())))
      (() none))))
!(test (left-out (B i0)) ())
!(test (left-out (B i13)) ((InstanceEvidence (BaseRateEvidence 0.0 1.0) (BaseRateEvidence 0.0 0.0))))
