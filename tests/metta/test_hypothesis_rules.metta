!(import! &self ../../pettachainer/metta/petta_chainer)

;; Hypotheses are refined rules with a weak prior; the data confirms or
;; rejects them (docs/metta/hypothesis_rules.md). k = 5 lets twenty cases
;; count.
!(set-evidence-confidence-k 5)
!(set-rule-refinement hypKb true)
!(compileadd hypKb (: real (Implication (A $x) (B $x)) (CTV (STV 0.5 0.02) (STV 0.5 0.02))))
!(compileadd hypKb (: idle (Implication (C $x) (B $x)) (CTV (STV 0.5 0.02) (STV 0.5 0.02))))
;; B holds in 8 of 10 cases with A and 2 of 10 without; C is unrelated.
!(compileadd hypKb (: a1 (A i1) (STV 1 1)))
!(compileadd hypKb (: b1 (B i1) (STV 1 1)))
!(compileadd hypKb (: c1 (C i1) (STV 1 1)))
!(compileadd hypKb (: a2 (A i2) (STV 1 1)))
!(compileadd hypKb (: b2 (B i2) (STV 1 1)))
!(compileadd hypKb (: c2 (C i2) (STV 0 1)))
!(compileadd hypKb (: a3 (A i3) (STV 1 1)))
!(compileadd hypKb (: b3 (B i3) (STV 1 1)))
!(compileadd hypKb (: c3 (C i3) (STV 1 1)))
!(compileadd hypKb (: a4 (A i4) (STV 1 1)))
!(compileadd hypKb (: b4 (B i4) (STV 1 1)))
!(compileadd hypKb (: c4 (C i4) (STV 0 1)))
!(compileadd hypKb (: a5 (A i5) (STV 1 1)))
!(compileadd hypKb (: b5 (B i5) (STV 1 1)))
!(compileadd hypKb (: c5 (C i5) (STV 1 1)))
!(compileadd hypKb (: a6 (A i6) (STV 1 1)))
!(compileadd hypKb (: b6 (B i6) (STV 1 1)))
!(compileadd hypKb (: c6 (C i6) (STV 0 1)))
!(compileadd hypKb (: a7 (A i7) (STV 1 1)))
!(compileadd hypKb (: b7 (B i7) (STV 1 1)))
!(compileadd hypKb (: c7 (C i7) (STV 1 1)))
!(compileadd hypKb (: a8 (A i8) (STV 1 1)))
!(compileadd hypKb (: b8 (B i8) (STV 1 1)))
!(compileadd hypKb (: c8 (C i8) (STV 0 1)))
!(compileadd hypKb (: a9 (A i9) (STV 1 1)))
!(compileadd hypKb (: b9 (B i9) (STV 0 1)))
!(compileadd hypKb (: c9 (C i9) (STV 1 1)))
!(compileadd hypKb (: a10 (A i10) (STV 1 1)))
!(compileadd hypKb (: b10 (B i10) (STV 0 1)))
!(compileadd hypKb (: c10 (C i10) (STV 0 1)))
!(compileadd hypKb (: a11 (A i11) (STV 0 1)))
!(compileadd hypKb (: b11 (B i11) (STV 1 1)))
!(compileadd hypKb (: c11 (C i11) (STV 1 1)))
!(compileadd hypKb (: a12 (A i12) (STV 0 1)))
!(compileadd hypKb (: b12 (B i12) (STV 1 1)))
!(compileadd hypKb (: c12 (C i12) (STV 0 1)))
!(compileadd hypKb (: a13 (A i13) (STV 0 1)))
!(compileadd hypKb (: b13 (B i13) (STV 0 1)))
!(compileadd hypKb (: c13 (C i13) (STV 1 1)))
!(compileadd hypKb (: a14 (A i14) (STV 0 1)))
!(compileadd hypKb (: b14 (B i14) (STV 0 1)))
!(compileadd hypKb (: c14 (C i14) (STV 0 1)))
!(compileadd hypKb (: a15 (A i15) (STV 0 1)))
!(compileadd hypKb (: b15 (B i15) (STV 0 1)))
!(compileadd hypKb (: c15 (C i15) (STV 1 1)))
!(compileadd hypKb (: a16 (A i16) (STV 0 1)))
!(compileadd hypKb (: b16 (B i16) (STV 0 1)))
!(compileadd hypKb (: c16 (C i16) (STV 0 1)))
!(compileadd hypKb (: a17 (A i17) (STV 0 1)))
!(compileadd hypKb (: b17 (B i17) (STV 0 1)))
!(compileadd hypKb (: c17 (C i17) (STV 1 1)))
!(compileadd hypKb (: a18 (A i18) (STV 0 1)))
!(compileadd hypKb (: b18 (B i18) (STV 0 1)))
!(compileadd hypKb (: c18 (C i18) (STV 0 1)))
!(compileadd hypKb (: a19 (A i19) (STV 0 1)))
!(compileadd hypKb (: b19 (B i19) (STV 0 1)))
!(compileadd hypKb (: c19 (C i19) (STV 1 1)))
!(compileadd hypKb (: a20 (A i20) (STV 0 1)))
!(compileadd hypKb (: b20 (B i20) (STV 0 1)))
!(compileadd hypKb (: c20 (C i20) (STV 0 1)))

(: hypothesis-scores (-[det]-> Atom))
(= (hypothesis-scores)
   (collapse (match &sk_rule_truth ($id $_h (RuleTruth (Implication ($head $_v) $_b)) $_k) ($head (sk-rule-score $id)))))

;; Before any review a hypothesis that claims no effect scores at the floor:
;; it is reached only with budget to spare.
!(test (hypothesis-scores) ((A 0.0099) (A 0.009000000000000001) (C 0.0099) (C 0.009000000000000001)))

;; A review learns both branches from the instances: P(B|A) from those with
;; A, P(B|not A) from those without (8 and 2 of 10 for A, 5 and 5 for C).
;; The cases arrive in order, so the last ones could be a new regime of the
;; rate (two failures after eight cases of B for P(B|A)); at the default
;; hazard that hypothesis keeps a small weight (0.793 against 0.797,
;; docs/metta/hypothesis_rules.md, "Regimes").
!(test
   (let (: $p $t $tv) (query 50 hypKb (: $p (RuleTruth (Implication (C $x) (B $x))) $tv)) $tv)
   (STV 0.4992318014558537 0.6687146348286057))
!(test
   (let (: $p $t $tv) (query 50 hypKb (: $p (RuleTruth (Implication (A $x) (B $x))) $tv)) $tv)
   (STV 0.7934110109537581 0.6681312812545516))

;; The confirmed hypothesis is scored by what it adds; the rejected one, whose
;; consequent does not move with its antecedent, stays at the floor.
!(test (hypothesis-scores) ((A 0.39109222608625) (A 0.3555383873511364) (C 0.0099) (C 0.009000000000000001)))

;; A forward run applies the learned truth, not the prior.
!(compileadd hypKb (: anew (A new) (STV 1 1)))
!(forward-chain 20 hypKb (the (List (Statement KBContext Proof TV)) (((A new) (hypKb MAIN Nil) anew (STV 1 1)))))
!(test (let (: $p $t $tv) (query 0 hypKb (: $p (B new) $tv)) $tv) (STV 0.7934110109537581 0.6681312811298272))

;; Two hypotheses confirmed from the same cases, through correlated
;; antecedents. Each learns the single hypothesis's truth; their samples are
;; the same observations of the same consequents, so applied together they
;; are one view, not two that revise (docs/metta/hypothesis_rules.md, gap 5;
;; before: confidence 0.802, the cases counted twice).
!(set-rule-refinement ovKb true)
!(compileadd ovKb (: hA (Implication (A $x) (C $x)) (STV 0.5 0.02)))
!(compileadd ovKb (: hB (Implication (B $x) (C $x)) (STV 0.5 0.02)))
!(compileadd ovKb (: a1 (A i1) (STV 1 1)))
!(compileadd ovKb (: b1 (B i1) (STV 1 1)))
!(compileadd ovKb (: c1 (C i1) (STV 1 1)))
!(compileadd ovKb (: a2 (A i2) (STV 1 1)))
!(compileadd ovKb (: b2 (B i2) (STV 1 1)))
!(compileadd ovKb (: c2 (C i2) (STV 1 1)))
!(compileadd ovKb (: a3 (A i3) (STV 1 1)))
!(compileadd ovKb (: b3 (B i3) (STV 1 1)))
!(compileadd ovKb (: c3 (C i3) (STV 1 1)))
!(compileadd ovKb (: a4 (A i4) (STV 1 1)))
!(compileadd ovKb (: b4 (B i4) (STV 1 1)))
!(compileadd ovKb (: c4 (C i4) (STV 1 1)))
!(compileadd ovKb (: a5 (A i5) (STV 1 1)))
!(compileadd ovKb (: b5 (B i5) (STV 1 1)))
!(compileadd ovKb (: c5 (C i5) (STV 1 1)))
!(compileadd ovKb (: a6 (A i6) (STV 1 1)))
!(compileadd ovKb (: b6 (B i6) (STV 1 1)))
!(compileadd ovKb (: c6 (C i6) (STV 1 1)))
!(compileadd ovKb (: a7 (A i7) (STV 1 1)))
!(compileadd ovKb (: b7 (B i7) (STV 1 1)))
!(compileadd ovKb (: c7 (C i7) (STV 1 1)))
!(compileadd ovKb (: a8 (A i8) (STV 1 1)))
!(compileadd ovKb (: b8 (B i8) (STV 1 1)))
!(compileadd ovKb (: c8 (C i8) (STV 1 1)))
!(compileadd ovKb (: a9 (A i9) (STV 1 1)))
!(compileadd ovKb (: b9 (B i9) (STV 1 1)))
!(compileadd ovKb (: c9 (C i9) (STV 0 1)))
!(compileadd ovKb (: a10 (A i10) (STV 1 1)))
!(compileadd ovKb (: b10 (B i10) (STV 1 1)))
!(compileadd ovKb (: c10 (C i10) (STV 0 1)))
!(compileadd ovKb (: a11 (A i11) (STV 0 1)))
!(compileadd ovKb (: b11 (B i11) (STV 0 1)))
!(compileadd ovKb (: c11 (C i11) (STV 1 1)))
!(compileadd ovKb (: a12 (A i12) (STV 0 1)))
!(compileadd ovKb (: b12 (B i12) (STV 0 1)))
!(compileadd ovKb (: c12 (C i12) (STV 1 1)))
!(compileadd ovKb (: a13 (A i13) (STV 0 1)))
!(compileadd ovKb (: b13 (B i13) (STV 0 1)))
!(compileadd ovKb (: c13 (C i13) (STV 0 1)))
!(compileadd ovKb (: a14 (A i14) (STV 0 1)))
!(compileadd ovKb (: b14 (B i14) (STV 0 1)))
!(compileadd ovKb (: c14 (C i14) (STV 0 1)))
!(compileadd ovKb (: a15 (A i15) (STV 0 1)))
!(compileadd ovKb (: b15 (B i15) (STV 0 1)))
!(compileadd ovKb (: c15 (C i15) (STV 0 1)))
!(compileadd ovKb (: a16 (A i16) (STV 0 1)))
!(compileadd ovKb (: b16 (B i16) (STV 0 1)))
!(compileadd ovKb (: c16 (C i16) (STV 0 1)))
!(compileadd ovKb (: a17 (A i17) (STV 0 1)))
!(compileadd ovKb (: b17 (B i17) (STV 0 1)))
!(compileadd ovKb (: c17 (C i17) (STV 0 1)))
!(compileadd ovKb (: a18 (A i18) (STV 0 1)))
!(compileadd ovKb (: b18 (B i18) (STV 0 1)))
!(compileadd ovKb (: c18 (C i18) (STV 0 1)))
!(compileadd ovKb (: a19 (A i19) (STV 0 1)))
!(compileadd ovKb (: b19 (B i19) (STV 0 1)))
!(compileadd ovKb (: c19 (C i19) (STV 0 1)))
!(compileadd ovKb (: a20 (A i20) (STV 0 1)))
!(compileadd ovKb (: b20 (B i20) (STV 0 1)))
!(compileadd ovKb (: c20 (C i20) (STV 0 1)))
!(compileadd ovKb (: an (A new) (STV 1 1)))
!(compileadd ovKb (: bn (B new) (STV 1 1)))
;; Reviewed, the two give the single hypothesis's answer (0.793, 0.668 alone):
;; the other hypothesis's view of C new is no sample.
!(test (let (: $p $t $tv) (query 50 ovKb (: $p (RuleTruth (Implication (A $x) (C $x))) $tv)) $tv)
   (STV 0.7934110109537581 0.6681312812545516))
!(test (let (: $p $t $tv) (query 50 ovKb (: $p (RuleTruth (Implication (B $x) (C $x))) $tv)) $tv)
   (STV 0.7934110109537581 0.6681312812545516))
!(test (let (: $p $t $tv) (query 200 ovKb (: $p (C new) $tv)) $tv)
   (STV 0.7934110109537581 0.6681312811007503))

;; Refined trust rules, one per source, learned from ten labelled claims each
;; (ChainerGame's conflicting sources, in small; test_certain_merge.metta has
;; the stated form). The forward view of w through the system rule reads s's
;; claim about c1 through trust-s, and w's own claim is s's too. The two views
;; share only the rule's truth, a parameter of both, not an event either
;; observes: given it they are independent and revise. Before, they counted as
;; overlapping evidence and w's own claim was dropped.
!(set-rule-refinement refinedSharedKb true)
!(compileadd refinedSharedKb (: sys (Implication (And (Up c1 $t) (Up c2 $t)) (Up w $t)) (CTV (STV 0.9 1) (STV 0.1 1))))
!(compileadd refinedSharedKb (: trust-s (Implication (Claims s (Up $n $t)) (Up $n $t)) (CTV (STV 0.5 0.02) (STV 0.5 0.02))))
!(compileadd refinedSharedKb (: trust-r (Implication (Claims r (Up $n $t)) (Up $n $t)) (CTV (STV 0.5 0.02) (STV 0.5 0.02))))
!(compileadd refinedSharedKb (: trust-q (Implication (Claims q (Up $n $t)) (Up $n $t)) (CTV (STV 0.5 0.02) (STV 0.5 0.02))))
!(compileadd refinedSharedKb (: l1-0 (Up c1 h0) (STV 1 1)))
!(compileadd refinedSharedKb (: l2-0 (Up c2 h0) (STV 1 1)))
!(compileadd refinedSharedKb (: lw-0 (Up w h0) (STV 1 1)))
!(compileadd refinedSharedKb (: ks-0 (Claims s (Up c1 h0)) (STV 1 1)))
!(compileadd refinedSharedKb (: kq-0 (Claims q (Up c1 h0)) (STV 1 1)))
!(compileadd refinedSharedKb (: kr-0 (Claims r (Up c1 h0)) (STV 1 1)))
!(compileadd refinedSharedKb (: l1-1 (Up c1 h1) (STV 1 1)))
!(compileadd refinedSharedKb (: l2-1 (Up c2 h1) (STV 1 1)))
!(compileadd refinedSharedKb (: lw-1 (Up w h1) (STV 1 1)))
!(compileadd refinedSharedKb (: ks-1 (Claims s (Up c2 h1)) (STV 1 1)))
!(compileadd refinedSharedKb (: kq-1 (Claims q (Up c2 h1)) (STV 1 1)))
!(compileadd refinedSharedKb (: kr-1 (Claims r (Up c2 h1)) (STV 1 1)))
!(compileadd refinedSharedKb (: l1-2 (Up c1 h2) (STV 1 1)))
!(compileadd refinedSharedKb (: l2-2 (Up c2 h2) (STV 0 1)))
!(compileadd refinedSharedKb (: lw-2 (Up w h2) (STV 0 1)))
!(compileadd refinedSharedKb (: ks-2 (Claims s (Up w h2)) (STV 0 1)))
!(compileadd refinedSharedKb (: kq-2 (Claims q (Up w h2)) (STV 0 1)))
!(compileadd refinedSharedKb (: kr-2 (Claims r (Up w h2)) (STV 0 1)))
!(compileadd refinedSharedKb (: l1-3 (Up c1 h3) (STV 0 1)))
!(compileadd refinedSharedKb (: l2-3 (Up c2 h3) (STV 1 1)))
!(compileadd refinedSharedKb (: lw-3 (Up w h3) (STV 0 1)))
!(compileadd refinedSharedKb (: ks-3 (Claims s (Up c1 h3)) (STV 1 1)))
!(compileadd refinedSharedKb (: kq-3 (Claims q (Up c1 h3)) (STV 1 1)))
!(compileadd refinedSharedKb (: kr-3 (Claims r (Up c1 h3)) (STV 1 1)))
!(compileadd refinedSharedKb (: l1-4 (Up c1 h4) (STV 1 1)))
!(compileadd refinedSharedKb (: l2-4 (Up c2 h4) (STV 1 1)))
!(compileadd refinedSharedKb (: lw-4 (Up w h4) (STV 0 1)))
!(compileadd refinedSharedKb (: ks-4 (Claims s (Up c2 h4)) (STV 1 1)))
!(compileadd refinedSharedKb (: kq-4 (Claims q (Up c2 h4)) (STV 1 1)))
!(compileadd refinedSharedKb (: kr-4 (Claims r (Up c2 h4)) (STV 1 1)))
!(compileadd refinedSharedKb (: l1-5 (Up c1 h5) (STV 0 1)))
!(compileadd refinedSharedKb (: l2-5 (Up c2 h5) (STV 0 1)))
!(compileadd refinedSharedKb (: lw-5 (Up w h5) (STV 0 1)))
!(compileadd refinedSharedKb (: ks-5 (Claims s (Up w h5)) (STV 0 1)))
!(compileadd refinedSharedKb (: kq-5 (Claims q (Up w h5)) (STV 0 1)))
!(compileadd refinedSharedKb (: kr-5 (Claims r (Up w h5)) (STV 0 1)))
!(compileadd refinedSharedKb (: l1-6 (Up c1 h6) (STV 1 1)))
!(compileadd refinedSharedKb (: l2-6 (Up c2 h6) (STV 1 1)))
!(compileadd refinedSharedKb (: lw-6 (Up w h6) (STV 1 1)))
!(compileadd refinedSharedKb (: ks-6 (Claims s (Up c1 h6)) (STV 1 1)))
!(compileadd refinedSharedKb (: kq-6 (Claims q (Up c1 h6)) (STV 1 1)))
!(compileadd refinedSharedKb (: kr-6 (Claims r (Up c1 h6)) (STV 1 1)))
!(compileadd refinedSharedKb (: l1-7 (Up c1 h7) (STV 1 1)))
!(compileadd refinedSharedKb (: l2-7 (Up c2 h7) (STV 0 1)))
!(compileadd refinedSharedKb (: lw-7 (Up w h7) (STV 1 1)))
!(compileadd refinedSharedKb (: ks-7 (Claims s (Up c2 h7)) (STV 1 1)))
!(compileadd refinedSharedKb (: kq-7 (Claims q (Up c2 h7)) (STV 1 1)))
!(compileadd refinedSharedKb (: kr-7 (Claims r (Up c2 h7)) (STV 1 1)))
!(compileadd refinedSharedKb (: l1-8 (Up c1 h8) (STV 0 1)))
!(compileadd refinedSharedKb (: l2-8 (Up c2 h8) (STV 1 1)))
!(compileadd refinedSharedKb (: lw-8 (Up w h8) (STV 0 1)))
!(compileadd refinedSharedKb (: ks-8 (Claims s (Up w h8)) (STV 0 1)))
!(compileadd refinedSharedKb (: kq-8 (Claims q (Up w h8)) (STV 0 1)))
!(compileadd refinedSharedKb (: kr-8 (Claims r (Up w h8)) (STV 0 1)))
!(compileadd refinedSharedKb (: l1-9 (Up c1 h9) (STV 1 1)))
!(compileadd refinedSharedKb (: l2-9 (Up c2 h9) (STV 1 1)))
!(compileadd refinedSharedKb (: lw-9 (Up w h9) (STV 1 1)))
!(compileadd refinedSharedKb (: ks-9 (Claims s (Up c1 h9)) (STV 1 1)))
!(compileadd refinedSharedKb (: kq-9 (Claims q (Up c1 h9)) (STV 1 1)))
!(compileadd refinedSharedKb (: kr-9 (Claims r (Up c1 h9)) (STV 1 1)))
!(compileadd refinedSharedKb (: k1 (Claims s (Up c1 n)) (STV 1 1)))
!(compileadd refinedSharedKb (: k2 (Claims r (Up c2 n)) (STV 1 1)))
!(compileadd refinedSharedKb (: kw (Claims s (Up w n)) (STV 0 1)))
!(test (query 200 refinedSharedKb (: $p (Up w n) $tv)) (: (merge/revision (by sys (conjunction (by trust-s k1) (by trust-r k2))) (by trust-s kw)) (Up w n) (STV 0.41535401075338063 0.7723056361507247)))

;; Two refined hypotheses about one outcome, one more specific (ChainerGame
;; benchmarks/ona/repros/specificity.py): with L b the case always wins (3
;; cases), with L c never (9). For a case with S a and L b both apply; the
;; specific application reads a proper superset of the general one's facts,
;; so its antecedent entails the general one's, whose rate (0.25) is a
;; marginal over this case and cases it is not. The narrowest reference class
;; decides: the general rate is only the prior the specific one is read
;; under. Revised, the two gave 0.40. Both rules are reviewed before the new
;; case arrives, as a client reviews hypotheses after a round of labels.
!(set-rule-refinement specKb true)
!(set-positive-only-predicate specKb S)
!(set-positive-only-predicate specKb L)
!(compileadd specKb (: gen (Implication (S a $t) (Win $t)) (STV 0.5 0.01)))
!(compileadd specKb (: spec (Implication (And (S a $t) (L b $t)) (Win $t)) (STV 0.5 0.01)))
!(compileadd specKb (: s1 (S a t1) (STV 1 1)))
!(compileadd specKb (: l1 (L b t1) (STV 1 1)))
!(compileadd specKb (: w1 (Win t1) (STV 1 1)))
!(compileadd specKb (: s2 (S a t2) (STV 1 1)))
!(compileadd specKb (: l2 (L b t2) (STV 1 1)))
!(compileadd specKb (: w2 (Win t2) (STV 1 1)))
!(compileadd specKb (: s3 (S a t3) (STV 1 1)))
!(compileadd specKb (: l3 (L b t3) (STV 1 1)))
!(compileadd specKb (: w3 (Win t3) (STV 1 1)))
!(compileadd specKb (: s4 (S a t4) (STV 1 1)))
!(compileadd specKb (: l4 (L c t4) (STV 1 1)))
!(compileadd specKb (: w4 (Win t4) (STV 0 1)))
!(compileadd specKb (: s5 (S a t5) (STV 1 1)))
!(compileadd specKb (: l5 (L c t5) (STV 1 1)))
!(compileadd specKb (: w5 (Win t5) (STV 0 1)))
!(compileadd specKb (: s6 (S a t6) (STV 1 1)))
!(compileadd specKb (: l6 (L c t6) (STV 1 1)))
!(compileadd specKb (: w6 (Win t6) (STV 0 1)))
!(compileadd specKb (: s7 (S a t7) (STV 1 1)))
!(compileadd specKb (: l7 (L c t7) (STV 1 1)))
!(compileadd specKb (: w7 (Win t7) (STV 0 1)))
!(compileadd specKb (: s8 (S a t8) (STV 1 1)))
!(compileadd specKb (: l8 (L c t8) (STV 1 1)))
!(compileadd specKb (: w8 (Win t8) (STV 0 1)))
!(compileadd specKb (: s9 (S a t9) (STV 1 1)))
!(compileadd specKb (: l9 (L c t9) (STV 1 1)))
!(compileadd specKb (: w9 (Win t9) (STV 0 1)))
!(compileadd specKb (: s10 (S a t10) (STV 1 1)))
!(compileadd specKb (: l10 (L c t10) (STV 1 1)))
!(compileadd specKb (: w10 (Win t10) (STV 0 1)))
!(compileadd specKb (: s11 (S a t11) (STV 1 1)))
!(compileadd specKb (: l11 (L c t11) (STV 1 1)))
!(compileadd specKb (: w11 (Win t11) (STV 0 1)))
!(compileadd specKb (: s12 (S a t12) (STV 1 1)))
!(compileadd specKb (: l12 (L c t12) (STV 1 1)))
!(compileadd specKb (: w12 (Win t12) (STV 0 1)))
!(test (let (: $p $t $tv) (query 50 specKb (: $p (RuleTruth (Implication (S a $t) (Win $t))) $tv)) $tv) (STV 0.24569397197102627 0.7056385432963005))
!(test (let (: $p $t $tv) (query 50 specKb (: $p (RuleTruth (Implication (And (S a $t) (L b $t)) (Win $t))) $tv)) $tv) (STV 0.9917202260594017 0.37887466975565864))
!(compileadd specKb (: sx (S a new) (STV 1 1)))
!(compileadd specKb (: lx (L b new) (STV 1 1)))
!(test (query 200 specKb (: $p (Win new) $tv))
   (: (specializes (by spec (conjunction sx lx)) (by gen sx)) (Win new) (STV 0.9458095775159095 0.37887466519567625)))
