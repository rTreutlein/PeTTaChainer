!(import! &self ../../pettachainer/metta/petta_chainer)

;; A refined rule's instance tally keeps each branch (P(B|A), P(B|not A)) as
;; regimes: an old one, the current one and a candidate, the samples since a
;; possible change. Its truth is the posterior mixture over where the rate
;; changed, with a KB's hazard, the prior probability that a sample starts a
;; new regime (set-rule-change-hazard, default 0.0001; 0 keeps one regime)
;; (docs/metta/hypothesis_rules.md, "Regimes"). Only a rule over stages has
;; regimes: one over objects or concepts is stationary, so each KB declares
;; its instances stages.
!(set-evidence-confidence-k 5)

(: truth (-[semidet]-> KB Atom))
(= (truth $kb)
   (case (sk-key-value (sk-key (RuleTruth (Implication (A $x) (B $x))) ($kb MAIN Nil))) (
      ((sk-val ($_type $_kbctx $_proof $tv) $_ev $_deps) $tv)
      ($_none none))))

;; The positive branch's segments, (regime-segment id successes mass), oldest
;; first; id 0 is an empty candidate.
(: segments (-[det]-> KB Atom))
(= (segments $kb)
   (collapse (match &sk_instance_tally ($_hash (sk-fold ($kb $_p $_e $_i $_f $_fin $_m)) (instance-regimes $_h $_n $pos $_neg)) $pos)))

;; One branch fed samples of mass 1 directly, in order: (id outcome) pairs.
(: feed-step (-[det]-> Number (List RegimeSegment) Atom (List RegimeSegment)))
(= (feed-step $hazard $segs ($id $x))
   (let ($next $_at) (regime-take! 7 $hazard (the Number $id) $segs 0 (BaseRateEvidence 0.0 0.0) (BaseRateEvidence (the Number $x) 1.0)) $next))
(: fed (-[det]-> Number (List Atom) (List RegimeSegment)))
(= (fed $hazard $samples) (fold-flat (feed-step $hazard) () $samples))
;; Whether evidence is within a tolerance of the sums of all samples.
(: near-all? (-[det]-> BaseRateEvidenceState Number Number Number Bool))
(= (near-all? (BaseRateEvidence $w $m) $all-w $all-m $tolerance)
   (if (< (abs-math (- (/ $w $m) (/ $all-w $all-m))) $tolerance) (< (abs-math (- $m $all-m)) (* $tolerance $all-m)) false))

;; --- A change -------------------------------------------------------------
;; The rule held in 12 instances, then fails. In one regime (hazard 0) each
;; failure moves the truth a thirteenth. At the default hazard the failures
;; are a candidate regime whose posterior grows with each: the truth follows
;; the mixture, mostly the failures from the fifth on, and at the sixth the
;; candidate is more probably a change than not and becomes the current
;; segment.
!(set-rule-refinement offKb true)
!(set-argument-sorts offKb A (Stage))
!(set-argument-sorts offKb B (Stage))
!(set-rule-change-hazard offKb 0)
!(set-positive-only-predicate offKb A)
!(compileadd offKb (: h (Implication (A $x) (B $x)) (STV 0.5 0.02)))
!(compileadd offKb (: a0 (A i0) (STV 1 1)))
!(compileadd offKb (: b0 (B i0) (STV 1 1)))
!(compileadd offKb (: a1 (A i1) (STV 1 1)))
!(compileadd offKb (: b1 (B i1) (STV 1 1)))
!(compileadd offKb (: a2 (A i2) (STV 1 1)))
!(compileadd offKb (: b2 (B i2) (STV 1 1)))
!(compileadd offKb (: a3 (A i3) (STV 1 1)))
!(compileadd offKb (: b3 (B i3) (STV 1 1)))
!(compileadd offKb (: a4 (A i4) (STV 1 1)))
!(compileadd offKb (: b4 (B i4) (STV 1 1)))
!(compileadd offKb (: a5 (A i5) (STV 1 1)))
!(compileadd offKb (: b5 (B i5) (STV 1 1)))
!(compileadd offKb (: a6 (A i6) (STV 1 1)))
!(compileadd offKb (: b6 (B i6) (STV 1 1)))
!(compileadd offKb (: a7 (A i7) (STV 1 1)))
!(compileadd offKb (: b7 (B i7) (STV 1 1)))
!(compileadd offKb (: a8 (A i8) (STV 1 1)))
!(compileadd offKb (: b8 (B i8) (STV 1 1)))
!(compileadd offKb (: a9 (A i9) (STV 1 1)))
!(compileadd offKb (: b9 (B i9) (STV 1 1)))
!(compileadd offKb (: a10 (A i10) (STV 1 1)))
!(compileadd offKb (: b10 (B i10) (STV 1 1)))
!(compileadd offKb (: a11 (A i11) (STV 1 1)))
!(compileadd offKb (: b11 (B i11) (STV 1 1)))
!(test (let (: $p $t $tv) (query 50 offKb (: $p (RuleTruth (Implication (A $x) (B $x))) $tv)) $tv) (STV 0.9957841483979765 0.7076372315035799))
!(set-rule-refinement onKb true)
!(set-argument-sorts onKb A (Stage))
!(set-argument-sorts onKb B (Stage))
!(set-positive-only-predicate onKb A)
!(compileadd onKb (: h (Implication (A $x) (B $x)) (STV 0.5 0.02)))
!(compileadd onKb (: a0 (A i0) (STV 1 1)))
!(compileadd onKb (: b0 (B i0) (STV 1 1)))
!(compileadd onKb (: a1 (A i1) (STV 1 1)))
!(compileadd onKb (: b1 (B i1) (STV 1 1)))
!(compileadd onKb (: a2 (A i2) (STV 1 1)))
!(compileadd onKb (: b2 (B i2) (STV 1 1)))
!(compileadd onKb (: a3 (A i3) (STV 1 1)))
!(compileadd onKb (: b3 (B i3) (STV 1 1)))
!(compileadd onKb (: a4 (A i4) (STV 1 1)))
!(compileadd onKb (: b4 (B i4) (STV 1 1)))
!(compileadd onKb (: a5 (A i5) (STV 1 1)))
