;; --- Leave one out ----------------------------------------------------------
;; A reader leaves its own sample out of the segment holding it.
(: left-out (-[det]-> Statement Atom))
(= (left-out $statement)
   (case (collapse (match &sk_instance_tally ($hash (sk-fold (onKb $_p $_e $_i $_f $_fin $_m)) $_s) $hash)) (
      ((cons $hash $_rest) (sk-left-out $hash (cons (index-hash (sk-key $statement (onKb MAIN Nil))) ())))
      (() none))))
!(test (left-out (B i0)) ((instance-sample 1 0 (InstanceEvidence (BaseRateEvidence 1.0 1.0) (BaseRateEvidence 0.0 0.0)))))
!(test (left-out (B i13)) ((instance-sample 13 0 (InstanceEvidence (BaseRateEvidence 0.0 1.0) (BaseRateEvidence 0.0 0.0)))))
