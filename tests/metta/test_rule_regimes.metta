!(test (truth onKb) (STV 0.23601949605264932 0.6732636918165381))
!(test (segments onKb) (((regime-segment 1 12.0 12.0) (regime-segment 13 0.0 6.0) (regime-segment 0 0.0 0.0))))

;; --- A regime that returns -------------------------------------------------
;; At hazard 0.01: 12 cases held, 8 failed, then B holds again. The returning
;; samples are a candidate against the failures; once the posterior more
;; probably holds a change than not, the candidate becomes the current
;; segment, and since it matches the first regime the two merge: the truth
;; stands at once on all the cases B held.
!(set-rule-refinement recurKb true)
!(set-argument-sorts recurKb A (Stage))
!(set-argument-sorts recurKb B (Stage))
!(set-rule-change-hazard recurKb 0.01)
!(set-positive-only-predicate recurKb A)
!(compileadd recurKb (: h (Implication (A $x) (B $x)) (STV 0.5 0.02)))
!(compileadd recurKb (: a0 (A i0) (STV 1 1)))
!(compileadd recurKb (: b0 (B i0) (STV 1 1)))
!(compileadd recurKb (: a1 (A i1) (STV 1 1)))
!(compileadd recurKb (: b1 (B i1) (STV 1 1)))
!(compileadd recurKb (: a2 (A i2) (STV 1 1)))
!(compileadd recurKb (: b2 (B i2) (STV 1 1)))
!(compileadd recurKb (: a3 (A i3) (STV 1 1)))
!(compileadd recurKb (: b3 (B i3) (STV 1 1)))
!(compileadd recurKb (: a4 (A i4) (STV 1 1)))
!(compileadd recurKb (: b4 (B i4) (STV 1 1)))
!(compileadd recurKb (: a5 (A i5) (STV 1 1)))
!(compileadd recurKb (: b5 (B i5) (STV 1 1)))
!(compileadd recurKb (: a6 (A i6) (STV 1 1)))
!(compileadd recurKb (: b6 (B i6) (STV 1 1)))
!(compileadd recurKb (: a7 (A i7) (STV 1 1)))
!(compileadd recurKb (: b7 (B i7) (STV 1 1)))
!(compileadd recurKb (: a8 (A i8) (STV 1 1)))
!(compileadd recurKb (: b8 (B i8) (STV 1 1)))
!(compileadd recurKb (: a9 (A i9) (STV 1 1)))
!(compileadd recurKb (: b9 (B i9) (STV 1 1)))
!(compileadd recurKb (: a10 (A i10) (STV 1 1)))
!(compileadd recurKb (: b10 (B i10) (STV 1 1)))
!(compileadd recurKb (: a11 (A i11) (STV 1 1)))
!(compileadd recurKb (: b11 (B i11) (STV 1 1)))
!(compileadd recurKb (: a12 (A i12) (STV 1 1)))
!(compileadd recurKb (: b12 (B i12) (STV 0 1)))
!(compileadd recurKb (: a13 (A i13) (STV 1 1)))
!(compileadd recurKb (: b13 (B i13) (STV 0 1)))
!(compileadd recurKb (: a14 (A i14) (STV 1 1)))
!(compileadd recurKb (: b14 (B i14) (STV 0 1)))
!(compileadd recurKb (: a15 (A i15) (STV 1 1)))
!(compileadd recurKb (: b15 (B i15) (STV 0 1)))
!(compileadd recurKb (: a16 (A i16) (STV 1 1)))
!(compileadd recurKb (: b16 (B i16) (STV 0 1)))
!(compileadd recurKb (: a17 (A i17) (STV 1 1)))
!(compileadd recurKb (: b17 (B i17) (STV 0 1)))
!(compileadd recurKb (: a18 (A i18) (STV 1 1)))
!(compileadd recurKb (: b18 (B i18) (STV 0 1)))
!(compileadd recurKb (: a19 (A i19) (STV 1 1)))
!(compileadd recurKb (: b19 (B i19) (STV 0 1)))
!(test (let (: $p $t $tv) (query 50 recurKb (: $p (RuleTruth (Implication (A $x) (B $x))) $tv)) $tv) (STV 0.006755156782688479 0.6186543384236785))
!(compileadd recurKb (: a20 (A i20) (STV 1 1)))
!(compileadd recurKb (: b20 (B i20) (STV 1 1)))
!(test (query 0 recurKb (: $p (A i0) $tv)) (: a0 (A i0) (STV 1 1)))
!(test (truth recurKb) (STV 0.2215217937561685 0.6473363783893311))
!(compileadd recurKb (: a21 (A i21) (STV 1 1)))
!(compileadd recurKb (: b21 (B i21) (STV 1 1)))
!(test (query 0 recurKb (: $p (A i0) $tv)) (: a0 (A i0) (STV 1 1)))
!(test (truth recurKb) (STV 0.554012865776914 0.6787170311535041))
!(compileadd recurKb (: a22 (A i22) (STV 1 1)))
!(compileadd recurKb (: b22 (B i22) (STV 1 1)))
!(test (query 0 recurKb (: $p (A i0) $tv)) (: a0 (A i0) (STV 1 1)))
!(test (truth recurKb) (STV 0.99655224135262 0.7512890165698938))
!(test (segments recurKb) (((regime-segment 13 0.0 8.0) (regime-segment 1 15.0 15.0) (regime-segment 0 0.0 0.0))))

;; --- Three regimes ---------------------------------------------------------
;; Fed directly at hazard 0.01: 12 held, 12 failed, then B half the time.
;; Once the third regime is more probably a change than not, it needs room:
;; no two segments are more probably one regime than not, so the older one
;; least probably in the newest regime, all held, is dropped.
!(test (fed 0.01 ((1 1.0) (2 1.0) (3 1.0) (4 1.0) (5 1.0) (6 1.0) (7 1.0) (8 1.0) (9 1.0) (10 1.0) (11 1.0) (12 1.0) (13 0.0) (14 0.0) (15 0.0) (16 0.0) (17 0.0) (18 0.0) (19 0.0) (20 0.0) (21 0.0) (22 0.0) (23 0.0) (24 0.0) (25 0.0) (26 1.0) (27 0.0) (28 1.0) (29 0.0) (30 1.0) (31 0.0) (32 1.0) (33 0.0) (34 1.0) (35 0.0) (36 1.0) (37 0.0) (38 1.0) (39 0.0) (40 1.0) (41 0.0) (42 1.0) (43 0.0) (44 1.0) (45 0.0) (46 1.0) (47 0.0) (48 1.0))) ((regime-segment 13 0.0 13.0) (regime-segment 26 12.0 23.0) (regime-segment 0 0.0 0.0)))

