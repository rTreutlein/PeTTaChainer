!(import! &self ../../pettachainer/metta/petta_chainer)
!(set-bayes-prior-count 0)
!(set-positive-only-predicate explicitPriorKb A)
!(set-base-rate explicitPriorKb (A $x) (STV 0.5 1))
!(compileadd explicitPriorKb (: b (B q) (STV 1 1)))
!(compileadd explicitPriorKb (: r (Implication (A $x) (B $x))
   (CTV (STV 0.9 1) (STV 0.1 1))))
!(test (collapse (let (: $p $type (STV $s $_c))
   (query 1000 explicitPriorKb (: $q (A q) $tv)) $s)) (0.9))
;; The STV's inferred complement must use the supplied antecedent rate too.
!(set-positive-only-predicate explicitComplementKb A)
!(set-base-rate explicitComplementKb (A $x) (STV 0.5 1))
!(set-base-rate explicitComplementKb (B $x) (STV 0.5 1))
!(compileadd explicitComplementKb (: r (Implication (A $x) (B $x)) (STV 0.9 1)))
!(compileadd explicitComplementKb (: a (A q) (STV 0 1)))
!(test (collapse (let (: $p $type (STV $s $_c))
   (query 1000 explicitComplementKb (: $q (B q) $tv))
   (<= (abs-math (- $s 0.1)) 1e-12))) (true))
;; With no explicit rate the positive-only declaration still bars inversion.
!(set-positive-only-predicate noPriorKb A)
!(compileadd noPriorKb (: b (B q) (STV 1 1)))
!(compileadd noPriorKb (: r (Implication (A $x) (B $x))
   (CTV (STV 0.9 1) (STV 0.1 1))))
!(test (collapse (query 1000 noPriorKb (: $p (A q) $tv))) ())
;; A rate supplied after compilation and an unsuccessful query also wins.
!(set-base-rate noPriorKb (A $x) (STV 0.5 1))
!(test (collapse (let (: $p $type (STV $s $_c))
   (query 1000 noPriorKb (: $q (A q) $tv)) $s)) (0.9))
!(clear-base-rate noPriorKb (A $x))
!(test (collapse (query 1000 noPriorKb (: $p (A q) $tv))) ())
;; Classifying an open predicate against immutable inputs is nonbinding.
!(set-functional-predicate priorShapeKb At 2 (1))
!(test (let* (($pattern ($head a))
              ($_functional (functional-pattern? priorShapeKb (brand Statement $pattern))))
   (is-var $head)) true)
