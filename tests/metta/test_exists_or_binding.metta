!(import! &self ../../pettachainer/metta/petta_chainer)

!(set-evidence-confidence-k 800)
!(set-argument-sorts catsKb Cardinality (Object Value))
!(set-argument-sorts catsKb PopulationAt (Object Object))
!(set-argument-sorts catsKb ElementType (Object Concept))
!(set-argument-sorts catsKb AllMembersSatisfy (Object Concept))
!(compileadd catsKb (: n (Cardinality ParkCats (PointMass 3)) (STV 1 1)))
!(compileadd catsKb (: l (PopulationAt ParkCats Park) (STV 1 1)))
!(compileadd catsKb (: t (ElementType ParkCats Cat) (STV 1 1)))
!(compileadd catsKb (: c (AllMembersSatisfy ParkCats Cute) (STV 1 1)))
!(compileadd catsKb (: n1 (Cardinality LoneCat (PointMass 1)) (STV 1 1)))
!(compileadd catsKb (: l1 (PopulationAt LoneCat QuietPark) (STV 1 1)))
!(compileadd catsKb (: t1 (ElementType LoneCat Cat) (STV 1 1)))
!(compileadd catsKb (: c1 (AllMembersSatisfy LoneCat Cute) (STV 1 1)))

!(test (let (: $_p $_q (STV $s $confidence))
   (query 500 catsKb (: $p (GreaterThan (PointMass 3) 2) $tv)) (and (> $s 0.999) (> $confidence 0))) true)
!(test (let (: $_p $_q (STV $s $confidence))
   (query 500 catsKb (: $p (Or (GreaterThan (PointMass 3) 2) (GreaterThan (PointMass 1) 2)) $tv)) (and (> $s 0.999) (> $confidence 0))) true)
!(test (let (: $_p $_q (STV $s $confidence))
   (query 500 catsKb (: $p (Exists ($collection $count)
      (And (PopulationAt $collection Park) (ElementType $collection Cat)
         (AllMembersSatisfy $collection Cute) (Cardinality $collection $count)
         (GreaterThan $count 2))) $tv)) (and (> $s 0.999) (> $confidence 0))) true)
!(test (let (: $_p $_q (STV $s $confidence))
   (query 500 catsKb (: $p (Exists ($collection $count)
      (And (PopulationAt $collection Park) (ElementType $collection Cat)
         (AllMembersSatisfy $collection Cute) (Cardinality $collection $count)
         (Or (GreaterThan $count 2) (Cardinality $collection (PointMass 2))))) $tv)) (and (> $s 0.999) (> $confidence 0))) true)
!(test (let (: $_p $_q (STV $s $confidence))
   (query 500 catsKb (: $p (Exists ($collection $count)
      (And (PopulationAt $collection Park) (ElementType $collection Cat)
         (AllMembersSatisfy $collection Cute) (Cardinality $collection $count)
         (Or (Cardinality $collection (PointMass 2)) (GreaterThan $count 2)))) $tv)) (and (> $s 0.999) (> $confidence 0))) true)

;; A false comparison cannot settle an Or whose other branch is unknown.
!(test (query 500 catsKb (: $p (Exists ($collection $count)
   (And (PopulationAt $collection QuietPark) (ElementType $collection Cat)
      (AllMembersSatisfy $collection Cute) (Cardinality $collection $count)
      (Or (GreaterThan $count 2) (Cardinality $collection (PointMass 2))))) $tv)) ())
!(test (query 500 catsKb (: $p (Exists ($collection $count)
   (And (PopulationAt $collection QuietPark) (ElementType $collection Cat)
      (AllMembersSatisfy $collection Cute) (Cardinality $collection $count)
      (Or (Cardinality $collection (PointMass 2)) (GreaterThan $count 2)))) $tv)) ())

;; #151: a certain Part branch supplies the same report witness to the rest.
!(set-argument-sorts reportKb About (Stage Any))
!(set-argument-sorts reportKb Part (Stage Any))
!(set-argument-sorts reportKb Source (Stage Object))
!(set-argument-sorts reportKb Claim (Stage))
!(set-argument-sorts reportKb Affirms (Stage))
!(set-argument-sorts reportKb A (Object))
!(set-argument-sorts reportKb B (Object))
!(set-argument-sorts reportKb C (Object))
!(set-constant-sort reportKb X Object)
!(set-constant-sort reportKb Source Object)
!(set-predicate-time reportKb ReportTime 2 0)
!(set-positive-only-predicate reportKb About)
!(set-positive-only-predicate reportKb Part)
!(set-positive-only-predicate reportKb Source)
!(set-positive-only-predicate reportKb Claim)
!(set-positive-only-predicate reportKb ReportTime)
!(compileadd reportKb (: part (Part report (A X)) (STV 1 1)))
!(compileadd reportKb (: partB (Part report (B X)) (STV 1 1)))
!(compileadd reportKb (: source (Source report Source) (STV 1 1)))
!(compileadd reportKb (: claim (Claim report) (STV 1 1)))
!(compileadd reportKb (: affirms (Affirms report) (STV 1 1)))
!(compileadd reportKb (: rule (Implication (And (A X) (B X)) (Affirms report))
   (CTV (STV 0.8 1) (STV 0.2 1))))
!(test (let (: $_p $_q (STV $s $confidence))
   (query 700 reportKb (: $p (Exists ($r)
      (And (Part $r (A X)) (Source $r Source) (Claim $r) (Affirms $r))) $tv)) (and (> $s 0.999) (> $confidence 0))) true)
!(test (let (: $_p $_q (STV $s $confidence))
   (query 700 reportKb (: $p (Exists ($r)
      (And (Or (About $r (A X)) (Part $r (A X)))
         (Source $r Source) (Claim $r) (Affirms $r))) $tv)) (and (> $s 0.999) (> $confidence 0))) true)
!(test (let (: $_p $_q (STV $s $confidence))
   (query 700 reportKb (: $p (Exists ($r)
      (And (Or (Part $r (B X)) (About $r (B X)))
         (Source $r Source) (Claim $r) (Affirms $r))) $tv)) (and (> $s 0.999) (> $confidence 0))) true)
!(test (query 700 reportKb (: $p (Exists ($r)
   (And (Or (About $r (C X)) (Part $r (C X)))
      (Source $r Source) (Claim $r) (Affirms $r))) $tv)) ())

;; Each conjunct must refer to the same report, even after fold abstraction.
!(compileadd splitReportKb (: part (Part first (A X)) (STV 1 1)))
!(compileadd splitReportKb (: claim (Claim first) (STV 1 1)))
!(compileadd splitReportKb (: affirms (Affirms first) (STV 1 1)))
!(compileadd splitReportKb (: source (Source second Source) (STV 1 1)))
!(test (query 700 splitReportKb (: $p (Exists ($r)
   (And (Or (About $r (A X)) (Part $r (A X)))
      (Source $r Source) (Claim $r) (Affirms $r))) $tv)) ())
