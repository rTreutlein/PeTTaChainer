!(import! &self ../../pettachainer/metta/petta_chainer)

;; A class link read as a compound's part gets its link rules where the part
;; is expanded, not only from a query root: each compound answers on a cold KB
;; as it does after a query of the link itself.
;; a: H M A; b: H; c: M A; d: A; e: H M A.

!(compileadd andKb (: ah (Member a Human) (STV 1 1)))
!(compileadd andKb (: am (Member a Mortal) (STV 1 1)))
!(compileadd andKb (: aa (Member a Animal) (STV 1 1)))
!(compileadd andKb (: bh (Member b Human) (STV 1 1)))
!(compileadd andKb (: bm (Member b Mortal) (STV 0 1)))
!(compileadd andKb (: ba (Member b Animal) (STV 0 1)))
!(compileadd andKb (: ch (Member c Human) (STV 0 1)))
!(compileadd andKb (: cm (Member c Mortal) (STV 1 1)))
!(compileadd andKb (: ca (Member c Animal) (STV 1 1)))
!(compileadd andKb (: dh (Member d Human) (STV 0 1)))
!(compileadd andKb (: dm (Member d Mortal) (STV 0 1)))
!(compileadd andKb (: da (Member d Animal) (STV 1 1)))
!(compileadd andKb (: eh (Member e Human) (STV 1 1)))
!(compileadd andKb (: em (Member e Mortal) (STV 1 1)))
!(compileadd andKb (: ea (Member e Animal) (STV 1 1)))
!(test (query 100 andKb (: $p (And (Inheritance Human Mortal) (Inheritance Mortal Animal)) $tv))
   (: (conjunction (implication-instance-fold cpu) (implication-instance-fold cpu)) (And (Inheritance Human Mortal) (Inheritance Mortal Animal)) (STV 0.6666666666666666 0.003735978871298817)))

!(compileadd notAndKb (: ah (Member a Human) (STV 1 1)))
!(compileadd notAndKb (: am (Member a Mortal) (STV 1 1)))
!(compileadd notAndKb (: aa (Member a Animal) (STV 1 1)))
!(compileadd notAndKb (: bh (Member b Human) (STV 1 1)))
!(compileadd notAndKb (: bm (Member b Mortal) (STV 0 1)))
!(compileadd notAndKb (: ba (Member b Animal) (STV 0 1)))
!(compileadd notAndKb (: ch (Member c Human) (STV 0 1)))
!(compileadd notAndKb (: cm (Member c Mortal) (STV 1 1)))
!(compileadd notAndKb (: ca (Member c Animal) (STV 1 1)))
!(compileadd notAndKb (: dh (Member d Human) (STV 0 1)))
!(compileadd notAndKb (: dm (Member d Mortal) (STV 0 1)))
!(compileadd notAndKb (: da (Member d Animal) (STV 1 1)))
!(compileadd notAndKb (: eh (Member e Human) (STV 1 1)))
!(compileadd notAndKb (: em (Member e Mortal) (STV 1 1)))
!(compileadd notAndKb (: ea (Member e Animal) (STV 1 1)))
!(test (query 100 notAndKb (: $p (Not (And (Inheritance Human Mortal) (Inheritance Mortal Animal))) $tv))
   (: (negated (conjunction (implication-instance-fold cpu) (implication-instance-fold cpu))) (Not (And (Inheritance Human Mortal) (Inheritance Mortal Animal))) (STV 0.33333333333333337 0.003735978871298817)))

!(compileadd orKb (: ah (Member a Human) (STV 1 1)))
!(compileadd orKb (: am (Member a Mortal) (STV 1 1)))
!(compileadd orKb (: aa (Member a Animal) (STV 1 1)))
!(compileadd orKb (: bh (Member b Human) (STV 1 1)))
!(compileadd orKb (: bm (Member b Mortal) (STV 0 1)))
!(compileadd orKb (: ba (Member b Animal) (STV 0 1)))
!(compileadd orKb (: ch (Member c Human) (STV 0 1)))
!(compileadd orKb (: cm (Member c Mortal) (STV 1 1)))
!(compileadd orKb (: ca (Member c Animal) (STV 1 1)))
!(compileadd orKb (: dh (Member d Human) (STV 0 1)))
!(compileadd orKb (: dm (Member d Mortal) (STV 0 1)))
!(compileadd orKb (: da (Member d Animal) (STV 1 1)))
!(compileadd orKb (: eh (Member e Human) (STV 1 1)))
!(compileadd orKb (: em (Member e Mortal) (STV 1 1)))
!(compileadd orKb (: ea (Member e Animal) (STV 1 1)))
!(test (query 100 orKb (: $p (Or (Inheritance Human Mortal) (Inheritance Mortal Animal)) $tv))
   (: (conjunction (implication-instance-fold cpu) (implication-instance-fold cpu)) (Or (Inheritance Human Mortal) (Inheritance Mortal Animal)) (STV 0.9999999999999999 0.02794653705953827)))

!(compileadd andFactKb (: ah (Member a Human) (STV 1 1)))
!(compileadd andFactKb (: am (Member a Mortal) (STV 1 1)))
!(compileadd andFactKb (: aa (Member a Animal) (STV 1 1)))
!(compileadd andFactKb (: bh (Member b Human) (STV 1 1)))
!(compileadd andFactKb (: bm (Member b Mortal) (STV 0 1)))
!(compileadd andFactKb (: ba (Member b Animal) (STV 0 1)))
!(compileadd andFactKb (: ch (Member c Human) (STV 0 1)))
!(compileadd andFactKb (: cm (Member c Mortal) (STV 1 1)))
!(compileadd andFactKb (: ca (Member c Animal) (STV 1 1)))
!(compileadd andFactKb (: dh (Member d Human) (STV 0 1)))
!(compileadd andFactKb (: dm (Member d Mortal) (STV 0 1)))
!(compileadd andFactKb (: da (Member d Animal) (STV 1 1)))
!(compileadd andFactKb (: eh (Member e Human) (STV 1 1)))
!(compileadd andFactKb (: em (Member e Mortal) (STV 1 1)))
!(compileadd andFactKb (: ea (Member e Animal) (STV 1 1)))
!(test (query 100 andFactKb (: $p (And (Inheritance Human Mortal) (Member a Human)) $tv))
   (: (conjunction (implication-instance-fold cpu) ah) (And (Inheritance Human Mortal) (Member a Human)) (STV 0.6666666666666666 0.0037359900373599006)))


;; The same compound after a query of the link answers alike.
!(compileadd warmKb (: ah (Member a Human) (STV 1 1)))
!(compileadd warmKb (: am (Member a Mortal) (STV 1 1)))
!(compileadd warmKb (: aa (Member a Animal) (STV 1 1)))
!(compileadd warmKb (: bh (Member b Human) (STV 1 1)))
!(compileadd warmKb (: bm (Member b Mortal) (STV 0 1)))
!(compileadd warmKb (: ba (Member b Animal) (STV 0 1)))
!(compileadd warmKb (: ch (Member c Human) (STV 0 1)))
!(compileadd warmKb (: cm (Member c Mortal) (STV 1 1)))
!(compileadd warmKb (: ca (Member c Animal) (STV 1 1)))
!(compileadd warmKb (: dh (Member d Human) (STV 0 1)))
!(compileadd warmKb (: dm (Member d Mortal) (STV 0 1)))
!(compileadd warmKb (: da (Member d Animal) (STV 1 1)))
!(compileadd warmKb (: eh (Member e Human) (STV 1 1)))
!(compileadd warmKb (: em (Member e Mortal) (STV 1 1)))
!(compileadd warmKb (: ea (Member e Animal) (STV 1 1)))
!(query 100 warmKb (: $p (Inheritance Human Mortal) $tv))
!(test (query 100 warmKb (: $p (And (Inheritance Human Mortal) (Inheritance Mortal Animal)) $tv))
   (: (conjunction (implication-instance-fold cpu) (implication-instance-fold cpu)) (And (Inheritance Human Mortal) (Inheritance Mortal Animal)) (STV 0.6666666666666666 0.003735978871298817)))

;; A negated implication part is the complement of the implication's
;; judgment, as the negation alone is read: a negated link, two of them, a
;; negated plain implication and one of two variables, each cold.
!(compileadd negLinkAndKb (: ah (Member a Human) (STV 1 1)))
!(compileadd negLinkAndKb (: am (Member a Mortal) (STV 1 1)))
!(compileadd negLinkAndKb (: aa (Member a Animal) (STV 1 1)))
!(compileadd negLinkAndKb (: bh (Member b Human) (STV 1 1)))
!(compileadd negLinkAndKb (: bm (Member b Mortal) (STV 0 1)))
!(compileadd negLinkAndKb (: ba (Member b Animal) (STV 0 1)))
!(compileadd negLinkAndKb (: ch (Member c Human) (STV 0 1)))
!(compileadd negLinkAndKb (: cm (Member c Mortal) (STV 1 1)))
!(compileadd negLinkAndKb (: ca (Member c Animal) (STV 1 1)))
!(compileadd negLinkAndKb (: dh (Member d Human) (STV 0 1)))
!(compileadd negLinkAndKb (: dm (Member d Mortal) (STV 0 1)))
!(compileadd negLinkAndKb (: da (Member d Animal) (STV 1 1)))
!(compileadd negLinkAndKb (: eh (Member e Human) (STV 1 1)))
!(compileadd negLinkAndKb (: em (Member e Mortal) (STV 1 1)))
!(compileadd negLinkAndKb (: ea (Member e Animal) (STV 1 1)))
!(compileadd negLinkAndKb (: fh (Member f Human) (STV 1 1)))
!(test (query 100 negLinkAndKb (: $p (And (Not (Inheritance Human Mortal)) (Member b Human)) $tv))
   (: (conjunction (negated (implication-instance-fold cpu)) bh) (And (Not (Inheritance Human Mortal)) (Member b Human)) (STV 0.33333333333333337 0.0037359900373599006)))
!(compileadd negLinksKb (: ah (Member a Human) (STV 1 1)))
!(compileadd negLinksKb (: am (Member a Mortal) (STV 1 1)))
!(compileadd negLinksKb (: aa (Member a Animal) (STV 1 1)))
!(compileadd negLinksKb (: bh (Member b Human) (STV 1 1)))
!(compileadd negLinksKb (: bm (Member b Mortal) (STV 0 1)))
!(compileadd negLinksKb (: ba (Member b Animal) (STV 0 1)))
!(compileadd negLinksKb (: ch (Member c Human) (STV 0 1)))
!(compileadd negLinksKb (: cm (Member c Mortal) (STV 1 1)))
!(compileadd negLinksKb (: ca (Member c Animal) (STV 1 1)))
!(compileadd negLinksKb (: dh (Member d Human) (STV 0 1)))
!(compileadd negLinksKb (: dm (Member d Mortal) (STV 0 1)))
!(compileadd negLinksKb (: da (Member d Animal) (STV 1 1)))
!(compileadd negLinksKb (: eh (Member e Human) (STV 1 1)))
!(compileadd negLinksKb (: em (Member e Mortal) (STV 1 1)))
!(compileadd negLinksKb (: ea (Member e Animal) (STV 1 1)))
!(compileadd negLinksKb (: fh (Member f Human) (STV 1 1)))
!(test (query 100 negLinksKb (: $p (And (Not (Inheritance Human Mortal)) (Not (Inheritance Mortal Animal))) $tv))
   (: (conjunction (negated (implication-instance-fold cpu)) (negated (implication-instance-fold cpu))) (And (Not (Inheritance Human Mortal)) (Not (Inheritance Mortal Animal))) (STV 0.0 0.02794653705953827)))
!(compileadd negImplicationKb (: ah (Member a Human) (STV 1 1)))
!(compileadd negImplicationKb (: am (Member a Mortal) (STV 1 1)))
!(compileadd negImplicationKb (: aa (Member a Animal) (STV 1 1)))
!(compileadd negImplicationKb (: bh (Member b Human) (STV 1 1)))
!(compileadd negImplicationKb (: bm (Member b Mortal) (STV 0 1)))
!(compileadd negImplicationKb (: ba (Member b Animal) (STV 0 1)))
!(compileadd negImplicationKb (: ch (Member c Human) (STV 0 1)))
!(compileadd negImplicationKb (: cm (Member c Mortal) (STV 1 1)))
!(compileadd negImplicationKb (: ca (Member c Animal) (STV 1 1)))
!(compileadd negImplicationKb (: dh (Member d Human) (STV 0 1)))
!(compileadd negImplicationKb (: dm (Member d Mortal) (STV 0 1)))
!(compileadd negImplicationKb (: da (Member d Animal) (STV 1 1)))
!(compileadd negImplicationKb (: eh (Member e Human) (STV 1 1)))
!(compileadd negImplicationKb (: em (Member e Mortal) (STV 1 1)))
!(compileadd negImplicationKb (: ea (Member e Animal) (STV 1 1)))
!(compileadd negImplicationKb (: fh (Member f Human) (STV 1 1)))
!(test (query 100 negImplicationKb (: $p (And (Not (Implication (Human $x) (Mortal $x))) (Member b Human)) $tv))
   (: (conjunction (negated (implication-instance-fold cpu)) bh) (And (Not (Implication (Human $_0) (Mortal $_0))) (Member b Human)) (STV 0.33333333333333337 0.0037359900373599006)))
!(compileadd negPairKb (: ah (Member a Human) (STV 1 1)))
!(compileadd negPairKb (: am (Member a Mortal) (STV 1 1)))
!(compileadd negPairKb (: aa (Member a Animal) (STV 1 1)))
!(compileadd negPairKb (: bh (Member b Human) (STV 1 1)))
!(compileadd negPairKb (: bm (Member b Mortal) (STV 0 1)))
!(compileadd negPairKb (: ba (Member b Animal) (STV 0 1)))
!(compileadd negPairKb (: ch (Member c Human) (STV 0 1)))
!(compileadd negPairKb (: cm (Member c Mortal) (STV 1 1)))
!(compileadd negPairKb (: ca (Member c Animal) (STV 1 1)))
!(compileadd negPairKb (: dh (Member d Human) (STV 0 1)))
!(compileadd negPairKb (: dm (Member d Mortal) (STV 0 1)))
!(compileadd negPairKb (: da (Member d Animal) (STV 1 1)))
!(compileadd negPairKb (: eh (Member e Human) (STV 1 1)))
!(compileadd negPairKb (: em (Member e Mortal) (STV 1 1)))
!(compileadd negPairKb (: ea (Member e Animal) (STV 1 1)))
!(compileadd negPairKb (: fh (Member f Human) (STV 1 1)))
!(compileadd negPairKb (: r1 (R p q) (STV 1 1)))
!(compileadd negPairKb (: s1 (S p q) (STV 0 1)))
!(compileadd negPairKb (: r2 (R p r) (STV 1 1)))
!(compileadd negPairKb (: s2 (S p r) (STV 1 1)))
!(test (query 100 negPairKb (: $p (And (Not (Implication (R $x $y) (S $x $y))) (Member b Human)) $tv))
   (: (conjunction (negated (implication-instance-fold cpu)) bh) (And (Not (Implication (R $_0 $_1) (S $_0 $_1))) (Member b Human)) (STV 0.5 0.0024937655860349127)))
