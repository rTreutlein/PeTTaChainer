!(compileadd binaryKb (: a11 (A i11 bob) (STV 1 1)))
!(compileadd binaryKb (: b11 (B i11) (STV 1 1)))
!(query 50 binaryKb (: $p (RuleTruth (Implication (A $x bob) (B $x))) $tv))
!(compileadd binaryKb (: a12 (A i12 bob) (STV 1 1)))
!(compileadd binaryKb (: b12 (B i12) (STV 0 1)))
