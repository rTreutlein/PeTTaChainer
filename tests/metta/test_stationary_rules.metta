!(import! &self ../../pettachainer/metta/petta_chainer)
!(import! &self ./posterior_assertions)

;; A rule keeps the rule-change hazard only if one of its variables can bind a
;; stage: at a position declared Stage or Time, or at one where a constant of
;; sort Stage or Time was stated. Every other rule is stationary, whatever its
;; arity: its truth is the plain frequency of its samples (prolog/sorts.pl).
!(set-evidence-confidence-k 5)

(: truth (-[semidet]-> KB Atom TV))
(= (truth $kb $rule)
   (case (sk-key-value (sk-key (RuleTruth $rule) ($kb MAIN Nil))) (
      ((sk-val ($_type $_kbctx $_proof (STV $s $c)) $_ev $_deps) (STV $s $c)))))

;; Instances declared stages by their constants: after 12 confirmations and
;; 6 failures the candidate regime of the failures has taken over, as with
;; Stage argument sorts (test_rule_regimes).
!(set-rule-refinement constantStageKb true)
!(set-constant-sort constantStageKb i0 Stage)
!(set-constant-sort constantStageKb i1 Stage)
!(set-constant-sort constantStageKb i2 Stage)
!(set-constant-sort constantStageKb i3 Stage)
!(set-constant-sort constantStageKb i4 Stage)
!(set-constant-sort constantStageKb i5 Stage)
!(set-constant-sort constantStageKb i6 Stage)
!(set-constant-sort constantStageKb i7 Stage)
!(set-constant-sort constantStageKb i8 Stage)
!(set-constant-sort constantStageKb i9 Stage)
!(set-constant-sort constantStageKb i10 Stage)
!(set-constant-sort constantStageKb i11 Stage)
!(set-constant-sort constantStageKb i12 Stage)
!(set-constant-sort constantStageKb i13 Stage)
!(set-constant-sort constantStageKb i14 Stage)
!(set-constant-sort constantStageKb i15 Stage)
!(set-constant-sort constantStageKb i16 Stage)
!(set-constant-sort constantStageKb i17 Stage)
!(set-positive-only-predicate constantStageKb A)
!(compileadd constantStageKb (: h (Implication (A $x) (B $x)) (STV 0.5 0.02)))
!(compileadd constantStageKb (: a0 (A i0) (STV 1 1)))
!(compileadd constantStageKb (: b0 (B i0) (STV 1 1)))
!(compileadd constantStageKb (: a1 (A i1) (STV 1 1)))
!(compileadd constantStageKb (: b1 (B i1) (STV 1 1)))
!(compileadd constantStageKb (: a2 (A i2) (STV 1 1)))
!(compileadd constantStageKb (: b2 (B i2) (STV 1 1)))
!(compileadd constantStageKb (: a3 (A i3) (STV 1 1)))
!(compileadd constantStageKb (: b3 (B i3) (STV 1 1)))
!(compileadd constantStageKb (: a4 (A i4) (STV 1 1)))
!(compileadd constantStageKb (: b4 (B i4) (STV 1 1)))
!(compileadd constantStageKb (: a5 (A i5) (STV 1 1)))
!(compileadd constantStageKb (: b5 (B i5) (STV 1 1)))
!(compileadd constantStageKb (: a6 (A i6) (STV 1 1)))
!(compileadd constantStageKb (: b6 (B i6) (STV 1 1)))
!(compileadd constantStageKb (: a7 (A i7) (STV 1 1)))
!(compileadd constantStageKb (: b7 (B i7) (STV 1 1)))
!(compileadd constantStageKb (: a8 (A i8) (STV 1 1)))
!(compileadd constantStageKb (: b8 (B i8) (STV 1 1)))
!(compileadd constantStageKb (: a9 (A i9) (STV 1 1)))
!(compileadd constantStageKb (: b9 (B i9) (STV 1 1)))
!(compileadd constantStageKb (: a10 (A i10) (STV 1 1)))
!(compileadd constantStageKb (: b10 (B i10) (STV 1 1)))
!(compileadd constantStageKb (: a11 (A i11) (STV 1 1)))
!(compileadd constantStageKb (: b11 (B i11) (STV 1 1)))
!(query 50 constantStageKb (: $p (RuleTruth (Implication (A $x) (B $x))) $tv))
!(compileadd constantStageKb (: a12 (A i12) (STV 1 1)))
!(compileadd constantStageKb (: b12 (B i12) (STV 0 1)))
!(query 0 constantStageKb (: $p (B i0) $tv))
!(compileadd constantStageKb (: a13 (A i13) (STV 1 1)))
!(compileadd constantStageKb (: b13 (B i13) (STV 0 1)))
!(query 0 constantStageKb (: $p (B i0) $tv))
!(compileadd constantStageKb (: a14 (A i14) (STV 1 1)))
!(compileadd constantStageKb (: b14 (B i14) (STV 0 1)))
!(query 0 constantStageKb (: $p (B i0) $tv))
!(compileadd constantStageKb (: a15 (A i15) (STV 1 1)))
!(compileadd constantStageKb (: b15 (B i15) (STV 0 1)))
!(query 0 constantStageKb (: $p (B i0) $tv))
!(compileadd constantStageKb (: a16 (A i16) (STV 1 1)))
!(compileadd constantStageKb (: b16 (B i16) (STV 0 1)))
!(query 0 constantStageKb (: $p (B i0) $tv))
!(compileadd constantStageKb (: a17 (A i17) (STV 1 1)))
!(compileadd constantStageKb (: b17 (B i17) (STV 0 1)))
!(query 0 constantStageKb (: $p (B i0) $tv))
!(test (posterior-tv-near? 0.23601949605264932 0.6732636918165381 (truth constantStageKb (Implication (A $x) (B $x)))) true)

