!(test (truth binaryKb (Implication (A $x bob) (B $x))) (STV 0.6657271702367531 0.7835689045936396))

;; A class link with no declarations is exact, whatever the order of its samples.
!(compileadd linkKb (: l1 (Member x1 Human) (STV 1 1)))
!(compileadd linkKb (: l2 (Member x1 Mortal) (STV 0 1)))
!(compileadd linkKb (: l3 (Member x2 Human) (STV 1 1)))
!(compileadd linkKb (: l4 (Member x2 Mortal) (STV 1 1)))
!(compileadd linkKb (: l5 (Member x3 Human) (STV 1 1)))
!(compileadd linkKb (: l6 (Member x3 Mortal) (STV 1 1)))
!(test
   (query 100 linkKb (: $proof (Inheritance Human Mortal) $tv))
   (: (implication-instance-fold cpu) (Inheritance Human Mortal) (STV 0.6666666666666666 0.375)))

;; A rule's hazard follows its stages as they are declared: a stage sort
;; given after the rule's tally was built, or stage constants reaching the
;; rule's position only then, rebuild the tally under the hazard.
!(set-rule-refinement stageAfterKb true)
!(set-positive-only-predicate stageAfterKb A)
!(compileadd stageAfterKb (: h (Implication (A $x) (B $x)) (STV 0.5 0.02)))
!(compileadd stageAfterKb (: a0 (A i0) (STV 1 1)))
!(compileadd stageAfterKb (: b0 (B i0) (STV 1 1)))
!(compileadd stageAfterKb (: a1 (A i1) (STV 1 1)))
!(compileadd stageAfterKb (: b1 (B i1) (STV 1 1)))
!(compileadd stageAfterKb (: a2 (A i2) (STV 1 1)))
!(compileadd stageAfterKb (: b2 (B i2) (STV 1 1)))
!(compileadd stageAfterKb (: a3 (A i3) (STV 1 1)))
!(compileadd stageAfterKb (: b3 (B i3) (STV 1 1)))
!(compileadd stageAfterKb (: a4 (A i4) (STV 1 1)))
!(compileadd stageAfterKb (: b4 (B i4) (STV 1 1)))
!(compileadd stageAfterKb (: a5 (A i5) (STV 1 1)))
!(compileadd stageAfterKb (: b5 (B i5) (STV 1 1)))
!(compileadd stageAfterKb (: a6 (A i6) (STV 1 1)))
!(compileadd stageAfterKb (: b6 (B i6) (STV 1 1)))
!(compileadd stageAfterKb (: a7 (A i7) (STV 1 1)))
!(compileadd stageAfterKb (: b7 (B i7) (STV 1 1)))
!(compileadd stageAfterKb (: a8 (A i8) (STV 1 1)))
