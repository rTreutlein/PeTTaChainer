!(compileadd stageAfterKb (: a9 (A i9) (STV 1 1)))
!(compileadd stageAfterKb (: b9 (B i9) (STV 1 1)))
!(compileadd stageAfterKb (: a10 (A i10) (STV 1 1)))
!(compileadd stageAfterKb (: b10 (B i10) (STV 1 1)))
!(compileadd stageAfterKb (: a11 (A i11) (STV 1 1)))
!(compileadd stageAfterKb (: b11 (B i11) (STV 1 1)))
