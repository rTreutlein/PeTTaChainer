!(compileadd binaryKb (: b5 (B i5) (STV 1 1)))
!(compileadd binaryKb (: a6 (A i6 bob) (STV 1 1)))
!(compileadd binaryKb (: b6 (B i6) (STV 1 1)))
!(compileadd binaryKb (: a7 (A i7 bob) (STV 1 1)))
!(compileadd binaryKb (: b7 (B i7) (STV 1 1)))
!(compileadd binaryKb (: a8 (A i8 bob) (STV 1 1)))
!(compileadd binaryKb (: b8 (B i8) (STV 1 1)))
!(compileadd binaryKb (: a9 (A i9 bob) (STV 1 1)))
!(compileadd binaryKb (: b9 (B i9) (STV 1 1)))
!(compileadd binaryKb (: a10 (A i10 bob) (STV 1 1)))
!(compileadd binaryKb (: b10 (B i10) (STV 1 1)))
!(compileadd binaryKb (: a11 (A i11 bob) (STV 1 1)))
!(compileadd binaryKb (: b11 (B i11) (STV 1 1)))
!(query 50 binaryKb (: $p (RuleTruth (Implication (A $x bob) (B $x))) $tv))
!(compileadd binaryKb (: a12 (A i12 bob) (STV 1 1)))
!(compileadd binaryKb (: b12 (B i12) (STV 0 1)))
!(query 0 binaryKb (: $p (B i0) $tv))
!(compileadd binaryKb (: a13 (A i13 bob) (STV 1 1)))
!(compileadd binaryKb (: b13 (B i13) (STV 0 1)))
!(query 0 binaryKb (: $p (B i0) $tv))
!(compileadd binaryKb (: a14 (A i14 bob) (STV 1 1)))
!(compileadd binaryKb (: b14 (B i14) (STV 0 1)))
!(query 0 binaryKb (: $p (B i0) $tv))
!(compileadd binaryKb (: a15 (A i15 bob) (STV 1 1)))
!(compileadd binaryKb (: b15 (B i15) (STV 0 1)))
!(query 0 binaryKb (: $p (B i0) $tv))
!(compileadd binaryKb (: a16 (A i16 bob) (STV 1 1)))
!(compileadd binaryKb (: b16 (B i16) (STV 0 1)))
!(query 0 binaryKb (: $p (B i0) $tv))
!(compileadd binaryKb (: a17 (A i17 bob) (STV 1 1)))
!(compileadd binaryKb (: b17 (B i17) (STV 0 1)))
!(query 0 binaryKb (: $p (B i0) $tv))
!(test (truth binaryKb (Implication (A $x bob) (B $x))) (STV 0.6657271702367531 0.7835689045936396))

;; A class link with no declarations is exact, whatever the order of its samples.
!(compileadd linkKb (: l1 (Member x1 Human) (STV 1 1)))
!(compileadd linkKb (: l2 (Member x1 Mortal) (STV 0 1)))
!(compileadd linkKb (: l3 (Member x2 Human) (STV 1 1)))
!(compileadd linkKb (: l4 (Member x2 Mortal) (STV 1 1)))
!(compileadd linkKb (: l5 (Member x3 Human) (STV 1 1)))
!(compileadd linkKb (: l6 (Member x3 Mortal) (STV 1 1)))
!(test
   (query 100 linkKb (: $proof (Inheritance Human Mortal) $tv))
   (: (implication-instance-fold cpu) (Inheritance Human Mortal) (STV 0.6666666666666666 0.375)))
