!(set-constant-sort stageAfterKb i14 Stage)
!(set-constant-sort stageAfterKb i15 Stage)
!(set-constant-sort stageAfterKb i16 Stage)
!(set-constant-sort stageAfterKb i17 Stage)
!(compileadd stageAfterKb (: a12 (A i12) (STV 1 1)))
!(compileadd stageAfterKb (: b12 (B i12) (STV 0 1)))
!(query 0 stageAfterKb (: $p (B i0) $tv))
!(compileadd stageAfterKb (: a13 (A i13) (STV 1 1)))
!(compileadd stageAfterKb (: b13 (B i13) (STV 0 1)))
!(query 0 stageAfterKb (: $p (B i0) $tv))
