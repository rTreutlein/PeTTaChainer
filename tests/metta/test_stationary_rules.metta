;; A head that gains a stage position after the samples were taken rebuilds
;; the tally under the rule's hazard at the next evaluation, in the order the
;; samples were first taken, with the samples still waiting after them: a sort
;; declared after the last sample, after revised samples, or after the first
;; query, gives what declaring it first gives; so does a rule-change hazard set
;; late.
!(set-rule-refinement sortLastKb true)
!(set-positive-only-predicate sortLastKb A)
!(compileadd sortLastKb (: h (Implication (A $x) (B $x)) (STV 0.5 0.02)))
!(compileadd sortLastKb (: a0 (A i0) (STV 1 1)))
!(compileadd sortLastKb (: b0 (B i0) (STV 1 1)))
!(compileadd sortLastKb (: a1 (A i1) (STV 1 1)))
!(compileadd sortLastKb (: b1 (B i1) (STV 1 1)))
!(compileadd sortLastKb (: a2 (A i2) (STV 1 1)))
!(compileadd sortLastKb (: b2 (B i2) (STV 1 1)))
!(compileadd sortLastKb (: a3 (A i3) (STV 1 1)))
!(compileadd sortLastKb (: b3 (B i3) (STV 1 1)))
!(compileadd sortLastKb (: a4 (A i4) (STV 1 1)))
!(compileadd sortLastKb (: b4 (B i4) (STV 1 1)))
!(compileadd sortLastKb (: a5 (A i5) (STV 1 1)))
!(compileadd sortLastKb (: b5 (B i5) (STV 1 1)))
!(compileadd sortLastKb (: a6 (A i6) (STV 1 1)))
!(compileadd sortLastKb (: b6 (B i6) (STV 1 1)))
!(compileadd sortLastKb (: a7 (A i7) (STV 1 1)))
!(compileadd sortLastKb (: b7 (B i7) (STV 1 1)))
!(compileadd sortLastKb (: a8 (A i8) (STV 1 1)))
!(compileadd sortLastKb (: b8 (B i8) (STV 1 1)))
!(compileadd sortLastKb (: a9 (A i9) (STV 1 1)))
!(compileadd sortLastKb (: b9 (B i9) (STV 1 1)))
!(compileadd sortLastKb (: a10 (A i10) (STV 1 1)))
!(compileadd sortLastKb (: b10 (B i10) (STV 1 1)))
!(compileadd sortLastKb (: a11 (A i11) (STV 1 1)))
!(compileadd sortLastKb (: b11 (B i11) (STV 1 1)))
!(query 50 sortLastKb (: $p (RuleTruth (Implication (A $x) (B $x))) $tv))
!(compileadd sortLastKb (: a12 (A i12) (STV 1 1)))
!(compileadd sortLastKb (: b12 (B i12) (STV 0 1)))
!(query 0 sortLastKb (: $p (B i0) $tv))
!(compileadd sortLastKb (: a13 (A i13) (STV 1 1)))
!(compileadd sortLastKb (: b13 (B i13) (STV 0 1)))
!(query 0 sortLastKb (: $p (B i0) $tv))
!(compileadd sortLastKb (: a14 (A i14) (STV 1 1)))
!(compileadd sortLastKb (: b14 (B i14) (STV 0 1)))
!(query 0 sortLastKb (: $p (B i0) $tv))
!(compileadd sortLastKb (: a15 (A i15) (STV 1 1)))
!(compileadd sortLastKb (: b15 (B i15) (STV 0 1)))
!(query 0 sortLastKb (: $p (B i0) $tv))
!(compileadd sortLastKb (: a16 (A i16) (STV 1 1)))
!(compileadd sortLastKb (: b16 (B i16) (STV 0 1)))
!(query 0 sortLastKb (: $p (B i0) $tv))
!(compileadd sortLastKb (: a17 (A i17) (STV 1 1)))
!(compileadd sortLastKb (: b17 (B i17) (STV 0 1)))
!(query 0 sortLastKb (: $p (B i0) $tv))
!(set-constant-sort sortLastKb i0 Stage)
